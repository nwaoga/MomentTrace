<Window x:Class="MomentTrace.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="680"
        Height="620"
        MinWidth="620"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Background="#08111F">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#08111F" />
        <SolidColorBrush x:Key="PanelBrush" Color="#121D2F" />
        <SolidColorBrush x:Key="SubtlePanelBrush" Color="#172337" />
        <SolidColorBrush x:Key="BorderBrush" Color="#26344D" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A5B0C3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2C2154" />

        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#1A263A" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#24334C" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#50617E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="#101A2B" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#34425C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#101A2B" />
                        <Setter Property="Foreground" Value="#F4F7FB" />
                        <Setter Property="Padding" Value="10,7" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="18">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Control startup, recording, appearance, and local storage paths." Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,24,0,20" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Recording" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
                    <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows" Margin="0,0,0,12" Checked="StartWithWindowsCheckBox_Changed" Unchecked="StartWithWindowsCheckBox_Changed" />
                    <Button x:Name="RecordingButton" Style="{StaticResource SettingsButton}" Content="Pause recording" Click="RecordingButton_Click" Width="160" HorizontalAlignment="Left" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24,0,20" />

                    <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Timeline view" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="Choose compact rows or Windows Timeline-style cards." Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="TimelineViewModeComboBox" Width="190" HorizontalAlignment="Right" SelectionChanged="TimelineViewModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Cards" />
                            <ComboBoxItem Content="List" />
                        </ComboBox>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Transparency" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="Adjusts how clear the dark shell is while keeping the same colour." Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="OpacityValueText" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <Slider x:Name="OpacitySlider" Minimum="55" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" ValueChanged="OpacitySlider_ValueChanged" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24,0,20" />

                    <TextBlock Text="Privacy filters" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
                    <CheckBox x:Name="ExcludeAdultWebsitesCheckBox"
                              Content="Exclude adult websites from history"
                              Margin="0,0,0,8"
                              Checked="ExcludeAdultWebsitesCheckBox_Changed"
                              Unchecked="ExcludeAdultWebsitesCheckBox_Changed" />
                    <TextBlock Text="Matching sites are skipped before they are saved or screenshotted. Checks are local." FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,14" />

                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Adult domain blocklist" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock x:Name="AdultBlocklistStatusText" Text="Built-in starter list" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <Button x:Name="UpdateAdultBlocklistButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource SettingsButton}"
                                Content="Update list"
                                Click="UpdateAdultBlocklistButton_Click"
                                Width="126" />
                    </DockPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Always exclude domains" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="CustomBlockedDomainsTextBox"
                                     Height="84"
                                     Margin="0,8,0,0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="#101A2B"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Always allow domains" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBox x:Name="CustomAllowedDomainsTextBox"
                                     Height="84"
                                     Margin="0,8,0,0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="#101A2B"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" />
                        </StackPanel>
                    </Grid>
                    <Button Style="{StaticResource SettingsButton}" Content="Save privacy filters" Click="SavePrivacyFiltersButton_Click" Width="168" HorizontalAlignment="Left" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24,0,20" />

                    <TextBlock Text="Where I Live" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Version" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,14,12" />
                        <TextBlock x:Name="VersionText" Grid.Column="1" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <TextBlock Grid.Row="1" Text="Installed at" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,14,12" />
                        <TextBlock x:Name="InstallPathText" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <TextBlock Grid.Row="2" Text="App data" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,14,12" />
                        <TextBlock x:Name="AppDataPathText" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <TextBlock Grid.Row="3" Text="Database" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,14,12" />
                        <TextBlock x:Name="DatabasePathText" Grid.Row="3" Grid.Column="1" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <TextBlock Grid.Row="4" Text="Settings file" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,14,0" />
                        <TextBlock x:Name="SettingsPathText" Grid.Row="4" Grid.Column="1" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SettingsButton}" Content="Close" Click="CloseButton_Click" Width="96" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
