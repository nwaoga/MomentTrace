<Application x:Class="MomentTrace.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F6F8FB" />
        <SolidColorBrush x:Key="RailBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SubtlePanelBrush" Color="#FAFCFF" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#F0F7FF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D9E1EA" />
        <SolidColorBrush x:Key="FaintBorderBrush" Color="#73D9E1EA" />
        <SolidColorBrush x:Key="PanelEdgeStrongBrush" Color="#B7C4D3" />
        <SolidColorBrush x:Key="TextBrush" Color="#202734" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6B7A" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F3FF" />
