        <SolidColorBrush x:Key="ToolbarBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToolbarHoverBrush" Color="#F0F7FF" />
        <SolidColorBrush x:Key="ChipBrush" Color="#F0F7FF" />
        <SolidColorBrush x:Key="OverlayBrush" Color="#B8F6F8FA" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#EEF2F6" />
        <SolidColorBrush x:Key="ActiveSurfaceBrush" Color="#E8F3FF" />
        <SolidColorBrush x:Key="ActiveEdgeBrush" Color="#7A9FD8" />
    </Application.Resources>
</Application>
