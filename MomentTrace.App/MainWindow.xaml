<Window x:Class="MomentTrace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MomentTrace"
        Height="760"
        Width="1320"
        MinHeight="650"
        MinWidth="1080"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemRoot" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#F2F8FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowSurface"
            Background="#EAF6F8FB"
            BorderBrush="#88D9E1EA"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Border x:Name="RailSurface" Grid.Column="0" Background="#EAF1F5F9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <Border Width="32" Height="32" CornerRadius="4" Background="{StaticResource AccentBrush}" DockPanel.Dock="Left">
                        <TextBlock Text="▣" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Timeline" Margin="12,5,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                </DockPanel>

                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <Border Background="#E8EEF6" CornerRadius="4" Padding="0" Margin="0,0,0,8">
                        <Button Style="{StaticResource RailButton}" Click="TodayButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="28" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="Timeline" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Button Style="{StaticResource RailButton}" Click="TodayButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◎" Width="28" />
                            <TextBlock Text="Overview" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☑" Width="28" />
                            <TextBlock Text="Tasks" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◰" Width="28" />
                            <TextBlock Text="Notes" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="□" Width="28" />
                            <TextBlock Text="Files" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◌" Width="28" />
                            <TextBlock Text="Web" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Width="28" />
                            <TextBlock Text="Apps" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,22,0,0">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,18" />
                    <TextBlock Text="Pinned" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,12" />
                    <Button Style="{StaticResource RailButton}" Click="PinnedButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☁" Width="28" />
                            <TextBlock Text="Pinned items" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣" Width="28" Foreground="#185ABD" />
                            <TextBlock Text="Documents" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" Width="28" />
                            <TextBlock Text="Websites" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Button Style="{StaticResource RailButton}" Click="SettingsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Width="28" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                    <DockPanel Margin="4,20,0,0">
                        <Border Width="34" Height="34" CornerRadius="17" Background="#4C9A9A" DockPanel.Dock="Left">
                            <TextBlock Text="AJ" FontSize="13" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Avery Johnson" Margin="12,8,0,0" FontSize="13" Foreground="{StaticResource TextBrush}" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TopCommandSurface" Grid.Row="0" Background="#EAFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
                <Grid Margin="20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" VerticalAlignment="Center" />
                        <TextBlock Text="Search activities" Margin="42,0,0,0" Foreground="#8A96A6" IsHitTestVisible="False" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="⌕" Margin="16,0,0,0" Foreground="#64748B" FontSize="20" IsHitTestVisible="False" VerticalAlignment="Center" />
                    </Grid>
                    <ComboBox x:Name="KindFilter" Grid.Column="1" Margin="12,0" SelectionChanged="KindFilter_SelectionChanged" VerticalAlignment="Center">
                        <ComboBoxItem Content="All" IsSelected="True" />
                        <ComboBoxItem Content="App" />
                        <ComboBoxItem Content="Browser" />
                        <ComboBoxItem Content="Document" />
                        <ComboBoxItem Content="Development" />
                    </ComboBox>
                    <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Content="Refresh" Click="RefreshButton_Click" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Grid.Column="3" Style="{StaticResource ChromeButton}" Content="Settings" Click="SettingsButton_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="26,20,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="2" Background="#C7D1DD" HorizontalAlignment="Center" Margin="0,16,0,20" />

                <ListBox x:Name="TimelineList"
                         Grid.Column="1"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="TimelineList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="-28,8,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="16" Height="16" Fill="#394150" Stroke="#FFFFFF" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="  " />
                                            <TextBlock Text="{Binding ItemCount, StringFormat={}{0} activities}" Margin="10,5,0,0" FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,3,6,4" Padding="12,9" BorderBrush="#DCE5EF" BorderThickness="1" CornerRadius="4" Background="#F4FFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="24" Height="24" CornerRadius="4" Background="{Binding IconBackground}" HorizontalAlignment="Left">
                                        <Grid>
                                            <TextBlock Text="{Binding IconGlyph}" Foreground="{Binding IconForeground}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding ProgramIcon}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="340" />
                                        <TextBlock Text="{Binding PinMark}" Margin="10,1,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Location}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding StartTime}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                                    <Border Grid.Column="4" Background="{Binding KindBackground}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindLabel}" Foreground="{Binding KindForeground}" FontSize="12" FontWeight="SemiBold" />
                                    </Border>

                                    <TextBlock Grid.Column="5" Text="•••" Foreground="{StaticResource MutedTextBrush}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <Border x:Name="DetailSurface" Grid.Column="2" Background="#EAFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="28,28,26,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <Border Width="52" Height="52" CornerRadius="6" Background="{StaticResource AccentBrush}" DockPanel.Dock="Left">
                        <Grid>
                            <TextBlock x:Name="DetailIconFallbackText" Text="W" Foreground="White" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="DetailIconImage" Width="38" Height="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="DetailTitleText" Text="No activity selected" Margin="14,6,0,0" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="×" DockPanel.Dock="Right" FontSize="22" Foreground="{StaticResource TextBrush}" />
                </DockPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,28,0,24">
                    <Button Style="{StaticResource PrimaryButton}" Content="↗ Open" Click="OpenAppButton_Click" Margin="0,0,10,0" />
                    <Button x:Name="PinButton" Style="{StaticResource ChromeButton}" Content="Pin" Click="PinButton_Click" Margin="0,0,10,0" />
                    <Button Style="{StaticResource ChromeButton}" Content="Minimize" Click="MinimizeButton_Click" />
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Details" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,28,9" />
                    <TextBlock Grid.Column="1" Text="Activity" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,28,9" />
                    <TextBlock Grid.Column="2" Text="Related" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,9" />
                    <Border Grid.ColumnSpan="3" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Bottom" />
                    <Border Width="42" Height="3" Background="{StaticResource AccentBrush}" CornerRadius="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                </Grid>

                <StackPanel Grid.Row="3">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Type" Foreground="{StaticResource MutedTextBrush}" />
                        <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock x:Name="DetailKindText" Text="Select an activity" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Location" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="DetailAppText" Grid.Column="1" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Started" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="DetailStartedText" Grid.Column="1" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ended" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="DetailEndedText" Grid.Column="1" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Duration" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="DetailDurationText" Grid.Column="1" Foreground="{StaticResource TextBrush}" />
                    </Grid>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Process" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="DetailProcessText" Grid.Column="1" Foreground="{StaticResource TextBrush}" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,22" />
                    <TextBlock Text="Recent activity" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="Recorded by MomentTrace" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
                    <TextBlock x:Name="StatusText" Text="Recording foreground window activity with timestamps." FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />
                    <Button Style="{StaticResource ChromeButton}" Content="Open settings" Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
