                                        <TextBlock Text="★" Width="28" />
                                        <TextBlock Text="Saved Moments" />
                                    </StackPanel>
                                </Button>
                            </Border>
                            <Border x:Name="NotesNavHighlight" Background="Transparent" CornerRadius="7" Margin="0,0,0,6">
                                <Button Style="{StaticResource RailButton}" Click="LibraryFilter_Click" Tag="Notes">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="☰" Width="28" />
                                        <TextBlock Text="Notes" />
                                    </StackPanel>
                                </Button>
                            </Border>
                            <Border x:Name="BookmarksNavHighlight" Background="Transparent" CornerRadius="7" Margin="0,0,0,6">
                                <Button Style="{StaticResource RailButton}" Click="LibraryFilter_Click" Tag="Bookmarks">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⌑" Width="28" />
                                        <TextBlock Text="Bookmarks" />
                                    </StackPanel>
                                </Button>
                            </Border>
                            <Border Height="1" Background="#26344D" Margin="0,16,0,16" />
                            <TextBlock Text="Sources" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,10" />
                            <Border x:Name="AppsNavHighlight" Background="Transparent" CornerRadius="7" Margin="0,0,0,6">
                                <Button Style="{StaticResource RailButton}" Click="TimelineSourceFilter_Click" Tag="Apps">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▦" Width="28" />
                                        <TextBlock Text="Apps" />
                                    </StackPanel>
                                </Button>
                            </Border>
                            <Border x:Name="WebsitesNavHighlight" Background="Transparent" CornerRadius="7" Margin="0,0,0,6">
                                <Button Style="{StaticResource RailButton}" Click="TimelineSourceFilter_Click" Tag="Websites">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◎" Width="28" />
                                        <TextBlock Text="Websites" />
                                    </StackPanel>
                                </Button>
                            </Border>
                            <Border x:Name="FilesNavHighlight" Background="Transparent" CornerRadius="7" Margin="0,0,0,6">
                                <Button Style="{StaticResource RailButton}" Click="TimelineSourceFilter_Click" Tag="Files">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="□" Width="28" />
                                        <TextBlock Text="Files" />
                                    </StackPanel>
                                </Button>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3">
                        <Border Height="1" Background="#26344D" Margin="0,0,0,16" />
                        <DockPanel Margin="0,0,0,14">
                            <Border Width="34" Height="34" CornerRadius="17" Background="#8B5CF6" DockPanel.Dock="Left">
                                <TextBlock x:Name="UserInitialsText" Text="U" FontSize="13" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock x:Name="UserDisplayNameText" Text="User" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="UserAccountText" Text="" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </DockPanel>
                        <Button Style="{StaticResource RailButton}" Click="SettingsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Width="28" />
                                <TextBlock Text="Settings" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="66" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="TopCommandSurface" Grid.Row="0" Background="#0D1728" BorderBrush="#23314A" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
                    <Grid Margin="28,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="142" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" VerticalAlignment="Center" />
                            <TextBlock Text="Search moments, sessions, apps, or websites..." Margin="40,0,0,0" Foreground="#8C98AD" IsHitTestVisible="False" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="⌕" Margin="16,0,0,0" Foreground="#A5B0C3" FontSize="20" IsHitTestVisible="False" VerticalAlignment="Center" />
                        </Grid>
                        <ComboBox x:Name="DateFilter"
                                  Style="{StaticResource TopComboBox}"
                                  Grid.Column="1"
                                  Margin="14,0,0,0"
                                  DisplayMemberPath="Label"
                                  SelectionChanged="DateFilter_SelectionChanged"
                                  VerticalAlignment="Center" />
                        <ComboBox x:Name="KindFilter" Style="{StaticResource TopComboBox}" Grid.Column="2" Margin="10,0,0,0" SelectionChanged="KindFilter_SelectionChanged" VerticalAlignment="Center">
                            <ComboBoxItem Content="All" IsSelected="True" />
                            <ComboBoxItem Content="App" />
                            <ComboBoxItem Content="Browser" />
                            <ComboBoxItem Content="Document" />
                            <ComboBoxItem Content="Development" />
                        </ComboBox>
                        <Button x:Name="ToggleDetailsButton" Grid.Column="3" Style="{StaticResource ChromeButton}" Content="▤" Click="ToggleDetailsButton_Click" VerticalAlignment="Center" Margin="10,0,0,0" Padding="12,8" />
                        <Button Grid.Column="4" Style="{StaticResource ChromeButton}" Content="–" Click="MinimizeButton_Click" VerticalAlignment="Center" Margin="10,0,0,0" Padding="12,8" FontSize="16" />
                        <Button Grid.Column="5" Style="{StaticResource ChromeButton}" Content="×" Click="CloseWindowButton_Click" VerticalAlignment="Center" Margin="10,0,0,0" Padding="12,8" FontSize="16" />
                    </Grid>
                </Border>

                <Grid x:Name="TimelinePage" Grid.Row="1" Margin="28,20,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="2" Background="#25334E" HorizontalAlignment="Center" Margin="0,58,0,0" />

                    <ScrollViewer x:Name="TimelineCardScroller"
                                  Grid.ColumnSpan="2"
                                  Padding="0,0,10,22"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,20">
                            <TextBlock Text="Today" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="TodayActivityCountText" Text="0 moments" Margin="16,6,0,0" FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
                            <Border x:Name="ActiveFilterBadge" Background="#2C2154" BorderBrush="#4D3A8E" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="16,2,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="ActiveFilterText" Text="All moments" FontSize="11" Foreground="#D8CCFF" />
                            </Border>
                            <Border Background="#142033" BorderBrush="#293A57" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="16,2,0,0">
                                <TextBlock Text="Stored locally · Only visible to you" FontSize="11" Foreground="#A5B0C3" />
                            </Border>
                        </StackPanel>
                            <ItemsControl x:Name="TimelineCardGroups" ItemTemplate="{StaticResource TimelineCardGroupTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                    <ListBox x:Name="TimelineList"
                             Grid.Column="1"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemTemplate="{StaticResource TimelineCardItemTemplate}"
                             ItemsPanel="{StaticResource TimelineCardItemsPanel}"
                             SelectionChanged="TimelineList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Margin="0,8,0,12" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </Grid>

                <ScrollViewer x:Name="OverviewPage"
                              Grid.Row="1"
                              Margin="28,20,22,0"
                              Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Overview" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="A quiet read on how your day is taking shape." Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="OverviewDateText" Grid.Column="1" Text="Today" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl x:Name="SummaryCards" ItemTemplate="{StaticResource SummaryMetricTemplate}" Margin="0,0,0,22">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Background="#111B2C" BorderBrush="#293A57" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Daily activity heatmap" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="15-minute blocks, colored by activity density and type." Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="00:00" FontSize="11" Foreground="#718096" />
                                        <TextBlock Text="  ·  06:00  ·  12:00  ·  18:00  ·  " FontSize="11" Foreground="#718096" />
                                        <TextBlock Text="24:00" FontSize="11" Foreground="#718096" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl x:Name="ActivityHeatmap" ItemTemplate="{StaticResource HeatmapSegmentTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>

                            <Border Background="#111B2C" BorderBrush="#293A57" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="108" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Top applications" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <Button Grid.Column="1" Style="{StaticResource ChromeButton}" Content="Duration" Tag="Duration" Click="OverviewSort_Click" Padding="8,4" FontSize="11" />
                                        <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Content="Sessions" Tag="Sessions" Click="OverviewSort_Click" Padding="8,4" FontSize="11" Margin="6,0,0,0" />
                                        <Button Grid.Column="3" Style="{StaticResource ChromeButton}" Content="%" Tag="Percent" Click="OverviewSort_Click" Padding="8,4" FontSize="11" Margin="6,0,0,0" />
                                        <TextBlock Grid.Column="4" Text="Trend" Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl x:Name="TopApplicationsTable" ItemTemplate="{StaticResource TopApplicationTemplate}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#111B2C" BorderBrush="#293A57" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Focus timeline" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Active runs and natural gaps across the day." Margin="0,4,0,16" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    <ItemsControl x:Name="FocusTimeline">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <StaticResource ResourceKey="FocusBlockTemplate" />
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border x:Name="DetailSurface" Grid.Column="2" Background="#121B2B" BorderBrush="#23314A" BorderThickness="1,0,0,0" PreviewMouseLeftButtonDown="SectionSurface_PreviewMouseLeftButtonDown">
                <Grid>
                <Grid x:Name="TimelineDetailContent" Margin="24,30,22,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragSurface_MouseLeftButtonDown" />
                    <DockPanel Grid.Row="0" MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="×" Click="ToggleDetailsButton_Click" Padding="9,3" BorderThickness="0" Background="Transparent" FontSize="20" />
                        <Border Width="62" Height="62" CornerRadius="9" Background="#19263B" DockPanel.Dock="Left">
                            <Grid>
                                <TextBlock x:Name="DetailIconFallbackText" Text="W" Foreground="#C9D4E6" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="DetailIconImage" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="14,5,0,0">
                            <TextBlock x:Name="DetailTitleText" Text="No activity selected" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="DetailAppText" Text="" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,24,0,28">
                        <Button Style="{StaticResource PrimaryButton}" Content="↗ Open" Click="OpenAppButton_Click" Margin="0,0,10,0" />
                        <Button x:Name="PinButton" Style="{StaticResource ChromeButton}" Content="Pin" Click="PinButton_Click" Margin="0,0,10,0" />
                        <Button x:Name="BookmarkButton" Style="{StaticResource ChromeButton}" Content="Bookmark" Click="BookmarkButton_Click" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Details" FontSize="13" FontWeight="SemiBold" Foreground="#B89CFF" Margin="0,0,28,10" />
                        <TextBlock Grid.Column="1" Text="Activity" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,28,10" />
                        <TextBlock Grid.Column="2" Text="Related" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                        <Border Grid.ColumnSpan="3" Height="1" Background="#26344D" VerticalAlignment="Bottom" />
                        <Border Width="42" Height="3" Background="#8B5CF6" CornerRadius="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                    </Grid>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#18243A" BorderBrush="#33435E" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Moment overview" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                                    <TextBlock x:Name="DetailNarrativeText" Text="Select a moment to see the context around it." FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="19" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="ScreenshotPreviewBorder"
                                    Height="150"
                                    Background="#0D1728"
                                    BorderBrush="#2B3A55"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    ClipToBounds="True"
                                    Margin="0,0,0,18"
                                    Visibility="Collapsed">
                                <Image x:Name="ScreenshotPreviewImage" Stretch="UniformToFill" />
                            </Border>

                            <Border Background="#1A263A" BorderBrush="#2B3A55" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Duration" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
                                    <TextBlock x:Name="DetailDurationText" Grid.Column="1" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />

                                    <TextBlock Grid.Row="1" Text="From" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
                                    <TextBlock x:Name="DetailStartedText" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <TextBlock Grid.Row="2" Text="Until" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
                                    <TextBlock x:Name="DetailEndedText" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <TextBlock Grid.Row="3" Text="Source" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
                                    <TextBlock x:Name="DetailProcessText" Grid.Row="3" Grid.Column="1" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />

                                    <TextBlock Grid.Row="4" Text="Category" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
                                    <Border Grid.Row="4" Grid.Column="1" Background="#2C2154" CornerRadius="5" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock x:Name="DetailKindText" Text="Select an activity" Foreground="#B89CFF" FontSize="12" FontWeight="SemiBold" />
                                    </Border>

                                    <TextBlock Grid.Row="5" Text="Privacy" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Stored locally" Foreground="{StaticResource TextBrush}" />
                                </Grid>
                            </Border>

                            <Border Background="#1A263A" BorderBrush="#2B3A55" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Personal note" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <Button Grid.Column="1" Style="{StaticResource ChromeButton}" Content="Save note" Click="SaveNoteButton_Click" Padding="10,5" FontSize="11" />
                                    </Grid>
                                    <TextBox x:Name="MomentNoteTextBox"
                                             MinHeight="78"
                                             Padding="12"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="#101A2B"
                                             BorderBrush="#33435E"
                                             Foreground="{StaticResource TextBrush}"
                                             CaretBrush="{StaticResource TextBrush}" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="AiSummaryPanel" Background="#231D45" BorderBrush="#4D3A8E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="✦ AI Summary" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" />
                                    <TextBlock Text="Recorded while this window was active. Related sessions are grouped into the timeline so repeated activity reads as one continuous moment." FontSize="13" Foreground="#D6D1EA" TextWrapping="Wrap" LineHeight="19" />
                                </StackPanel>
                            </Border>

                            <Border Background="#1A263A" BorderBrush="#2B3A55" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Recent Activity" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
                                    <TextBlock Text="Recorded by MomentTrace" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                                    <TextBlock x:Name="StatusText" Text="Recording foreground window activity with timestamps." FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="19" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="OverviewSidebarContent" Margin="24,30,22,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Content="×" Click="ToggleDetailsButton_Click" Padding="9,3" BorderThickness="0" Background="Transparent" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="Day details" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="OverviewSidebarDateText" Text="Today" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,28,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#1A263A" BorderBrush="#2B3A55" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Activity totals" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Active time" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                                        <TextBlock x:Name="OverviewTotalActiveText" Grid.Column="1" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                                        <TextBlock Grid.Row="1" Text="Sessions" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                                        <TextBlock x:Name="OverviewSessionsText" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                                        <TextBlock Grid.Row="2" Text="Apps" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" />
                                        <TextBlock x:Name="OverviewAppsText" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                                        <TextBlock Grid.Row="3" Text="Longest focus" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock x:Name="OverviewFocusText" Grid.Row="3" Grid.Column="1" Foreground="{StaticResource TextBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#1A263A" BorderBrush="#2B3A55" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Quick filters" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" />
                                    <WrapPanel>
                                        <Border Background="#2C2154" CornerRadius="12" Padding="10,5" Margin="0,0,8,8">
                                            <TextBlock Text="All activity" Foreground="#D8CCFF" FontSize="12" />
                                        </Border>
                                        <Border Background="#162B44" CornerRadius="12" Padding="10,5" Margin="0,0,8,8">
                                            <TextBlock Text="Apps" Foreground="#AFC7E8" FontSize="12" />
                                        </Border>
                                        <Border Background="#172B29" CornerRadius="12" Padding="10,5" Margin="0,0,8,8">
                                            <TextBlock Text="Focus blocks" Foreground="#BDECC0" FontSize="12" />
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#1A263A" BorderBrush="#2B3A55" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Category legend" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" />
                                    <ItemsControl x:Name="OverviewLegend" ItemTemplate="{StaticResource LegendItemTemplate}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
