<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\MomentTrace.App\Assets\MomentTrace.ico</ApplicationIcon>
    <AssemblyTitle>MomentTrace</AssemblyTitle>
    <Product>MomentTrace</Product>
    <Company>MomentTrace</Company>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(MomentTraceBuildNumber)' != ''">
      <_Parameter1>BuildNumber</_Parameter1>
      <_Parameter2>$(MomentTraceBuildNumber)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(MomentTraceCommitSha)' != ''">
      <_Parameter1>CommitSha</_Parameter1>
      <_Parameter2>$(MomentTraceCommitSha)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\MomentTrace.App\Assets\MomentTrace.ico" Link="Assets\MomentTrace.ico" />
    <AvaloniaResource Include="..\MomentTrace.App\Assets\MomentTrace.png" Link="Assets\MomentTrace.png" />
    <AvaloniaResource Include="..\MomentTrace.App\Assets\MomentTrace.Template.png" Link="Assets\MomentTrace.Template.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MomentTrace.Core\MomentTrace.Core.csproj" />
    <ProjectReference Include="..\MomentTrace.Presentation\MomentTrace.Presentation.csproj" />
    <ProjectReference Include="..\MomentTrace.Storage\MomentTrace.Storage.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <ProjectReference Include="..\MomentTrace.Mac\MomentTrace.Mac.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <ProjectReference Include="..\MomentTrace.Windows\MomentTrace.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
