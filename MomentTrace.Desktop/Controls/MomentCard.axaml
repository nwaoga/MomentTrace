<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MomentTrace.Desktop.Controls"
             x:Class="MomentTrace.Desktop.Controls.MomentCard">
  <Border Background="{DynamicResource CardBrush}"
          BorderBrush="{DynamicResource FaintBorderBrush}"
          BorderThickness="1"
          CornerRadius="14"
          Padding="0"
          Width="198">
    <StackPanel Spacing="0">
      <Border x:Name="PreviewHost"
              Height="146"
              CornerRadius="14,14,0,0"
              Background="{DynamicResource ElevatedPanelBrush}"
              ClipToBounds="True">
        <Grid>
          <Image x:Name="PreviewImage"
                 Stretch="UniformToFill" />
          <Border Background="{Binding AccentFill, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                  CornerRadius="8"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="10,10,10,0"
                  Padding="8,4">
            <TextBlock Text="{Binding Timestamp, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                       Foreground="{Binding AccentText, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                       FontSize="10"
                       FontWeight="SemiBold" />
          </Border>
          <Border Background="{DynamicResource OverlayBrush}"
                  CornerRadius="8"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="10"
                  Padding="8,4">
            <TextBlock Text="{Binding Duration, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="10"
                       FontWeight="SemiBold" />
          </Border>
        </Grid>
      </Border>
      <Border Padding="12">
        <Grid RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,Auto"
              RowSpacing="4">
          <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                     Foreground="{DynamicResource TextBrush}"
                     FontWeight="SemiBold"
                     FontSize="13"
                     TextWrapping="Wrap"
                     MaxLines="2" />
          <Border Grid.Column="1"
                  Width="18"
                  Height="18"
                  Background="{Binding AccentFill, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                  CornerRadius="5"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=local:MomentCard}, FallbackValue='A'}"
                       Foreground="{Binding AccentText, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                       FontSize="9"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Grid.Row="1"
                     Text="{Binding Category, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                     Foreground="{DynamicResource MutedTextBrush}"
                     FontSize="11"
                     Margin="0,2,0,0"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
