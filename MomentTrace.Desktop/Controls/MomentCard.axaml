<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MomentTrace.Desktop.Controls"
             x:Class="MomentTrace.Desktop.Controls.MomentCard">
  <Border Background="{DynamicResource CardBrush}"
          BorderBrush="{DynamicResource FaintBorderBrush}"
          BorderThickness="1"
          CornerRadius="16"
          Padding="0"
          HorizontalAlignment="Stretch">
    <StackPanel Spacing="0">
      <Border x:Name="PreviewHost"
              Height="136"
              CornerRadius="16,16,0,0"
              Background="{DynamicResource ElevatedPanelBrush}"
              ClipToBounds="True">
        <Grid>
          <Image x:Name="PreviewImage"
                 Stretch="UniformToFill" />
          <Border Background="{Binding AccentFill, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                  CornerRadius="999"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="12,12,12,0"
                  Padding="10,5">
            <TextBlock Text="{Binding Timestamp, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                       Foreground="{Binding AccentText, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                       FontSize="11"
                       FontWeight="SemiBold" />
          </Border>
          <Border Background="{DynamicResource OverlayBrush}"
                  CornerRadius="999"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="12"
                  Padding="10,5">
            <TextBlock Text="{Binding Duration, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="11"
                       FontWeight="SemiBold" />
          </Border>
        </Grid>
      </Border>
      <Border Padding="14,12,14,14">
        <Grid RowDefinitions="Auto,Auto,Auto"
              ColumnDefinitions="*,Auto"
              RowSpacing="6"
              MinHeight="86">
          <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                     Foreground="{DynamicResource TextBrush}"
                     FontWeight="SemiBold"
                     FontSize="13"
                     TextWrapping="Wrap"
                     MaxLines="2" />
          <Border Grid.Column="1"
                  MinWidth="30"
                  Height="24"
                  Background="{Binding AccentFill, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                  CornerRadius="999"
                  Padding="7,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=local:MomentCard}, FallbackValue='A'}"
                       Foreground="{Binding AccentText, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                       FontSize="9"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Grid.Row="1"
                     Grid.ColumnSpan="2"
                     Text="{Binding Category, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                     Foreground="{DynamicResource MutedTextBrush}"
                     FontSize="11"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="2"
                     Grid.ColumnSpan="2"
                     Text="{Binding Source, RelativeSource={RelativeSource AncestorType=local:MomentCard}}"
                     Foreground="{DynamicResource SubtleTextBrush}"
                     FontSize="10"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis"
                     Opacity="0.92" />
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
