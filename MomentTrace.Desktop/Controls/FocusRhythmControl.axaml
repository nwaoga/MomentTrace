<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MomentTrace.Desktop.Controls"
             x:Class="MomentTrace.Desktop.Controls.FocusRhythmControl">
  <Border Background="{DynamicResource CardBrush}"
          BorderBrush="{DynamicResource FaintBorderBrush}"
          BorderThickness="1"
          CornerRadius="14"
          Padding="14,12,14,12">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:FocusRhythmControl}}"
                     Foreground="{DynamicResource TextBrush}"
                     FontSize="16"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=local:FocusRhythmControl}}"
                     Foreground="{DynamicResource SubtleTextBrush}"
                     FontSize="11" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Top">
          <Button x:Name="ScrollLeftButton"
                  Background="{DynamicResource ToolbarBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource FaintBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Width="36"
                  Height="36"
                  Padding="0"
                  Click="ScrollLeftButton_Click">
            <TextBlock Text="‹"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Button>
          <Button x:Name="ScrollRightButton"
                  Background="{DynamicResource ToolbarBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource FaintBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Width="36"
                  Height="36"
                  Padding="0"
                  Click="ScrollRightButton_Click">
            <TextBlock Text="›"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Button>
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="FocusScrollViewer"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled"
                    AllowAutoHide="False"
                    PointerPressed="FocusScrollViewer_PointerPressed"
                    PointerMoved="FocusScrollViewer_PointerMoved"
                    PointerReleased="FocusScrollViewer_PointerReleased">
        <Grid MinHeight="112"
              Margin="0,2,0,0">
          <Border Height="2"
                  Background="{DynamicResource PanelEdgeBrush}"
                  CornerRadius="999"
                  Margin="2,20,22,0"
                  VerticalAlignment="Top" />
          <Border Width="18"
                  Height="2"
                  Background="{DynamicResource PanelEdgeBrush}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,20,0,0"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <RotateTransform Angle="18" />
            </Border.RenderTransform>
          </Border>
          <ItemsControl ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=local:FocusRhythmControl}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"
                            Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Width="{Binding Width}"
                      MinWidth="108"
                      Margin="0,0,0,0"
                      RowDefinitions="Auto,Auto,Auto">
                  <TextBlock Text="{Binding StartedAtLabel}"
                             Foreground="{DynamicResource MutedTextBrush}"
                             FontSize="10"
                             IsVisible="{Binding ShowTimeLabel}"
                             HorizontalAlignment="Left" />
                  <Border Grid.Row="1"
                          Width="10"
                          Height="10"
                          CornerRadius="999"
                          Background="{Binding Fill}"
                          BorderBrush="{DynamicResource PageBackgroundBrush}"
                          BorderThickness="2"
                          Margin="0,7,0,0"
                          HorizontalAlignment="Left" />
                  <Button Grid.Row="2"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          Margin="0,7,0,0"
                          Command="{Binding ItemCommand, RelativeSource={RelativeSource AncestorType=local:FocusRhythmControl}}"
                          CommandParameter="{Binding}">
                    <Border Background="{Binding Fill}"
                            BorderBrush="{DynamicResource FaintBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,8"
                            MinHeight="50"
                            ToolTip.Tip="{Binding Tooltip}">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Label}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2" />
                        <TextBlock Text="{Binding DurationLabel}"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontSize="10" />
                      </StackPanel>
                    </Border>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </ScrollViewer>
    </StackPanel>
  </Border>
</UserControl>
