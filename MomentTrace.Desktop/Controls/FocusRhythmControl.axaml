<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MomentTrace.Desktop.Controls"
             x:Class="MomentTrace.Desktop.Controls.FocusRhythmControl">
  <Border Background="{DynamicResource RailBrush}"
          BorderBrush="{DynamicResource PanelEdgeBrush}"
          BorderThickness="1"
          CornerRadius="14"
          Padding="14">
    <Grid RowDefinitions="Auto,Auto,Auto">
      <Border Grid.Row="1"
              Height="2"
              Background="{DynamicResource PanelEdgeBrush}"
              CornerRadius="999"
              Margin="0,42,0,0"
              VerticalAlignment="Top" />
      <ScrollViewer Grid.RowSpan="3"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    AllowAutoHide="False">
        <ItemsControl ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=local:FocusRhythmControl}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="28" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Width="{Binding Width}"
                    MinWidth="156"
                    RowDefinitions="Auto,Auto,Auto">
                <TextBlock Text="{Binding StartedAt, StringFormat={}{0:HH:mm}}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11"
                           HorizontalAlignment="Left" />
                <Border Grid.Row="1"
                        Width="12"
                        Height="12"
                        CornerRadius="999"
                        Background="{Binding Fill}"
                        BorderBrush="{DynamicResource PageBackgroundBrush}"
                        BorderThickness="3"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left" />
                <Button Grid.Row="2"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="0,10,0,0"
                        Command="{Binding ItemCommand, RelativeSource={RelativeSource AncestorType=local:FocusRhythmControl}}"
                        CommandParameter="{Binding}">
                  <Border Background="{Binding Fill}"
                          BorderBrush="{DynamicResource PanelEdgeBrush}"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="10"
                          ToolTip.Tip="{Binding Tooltip}">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Label}"
                                 Foreground="White"
                                 FontWeight="SemiBold"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis"
                                 MaxLines="2" />
                      <TextBlock Text="{Binding Duration}"
                                 Foreground="#D7E3F4"
                                 FontSize="10" />
                    </StackPanel>
                  </Border>
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
