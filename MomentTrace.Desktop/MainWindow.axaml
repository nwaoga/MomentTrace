<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MomentTrace.Desktop.Controls"
        mc:Ignorable="d"
        x:Class="MomentTrace.Desktop.MainWindow"
        Title="MomentTrace"
        Icon="avares://MomentTrace.Desktop/Assets/MomentTrace.png"
	        Width="1360"
	        Height="840"
	        MinWidth="1120"
	        MinHeight="720"
	        TransparencyLevelHint="Blur, Transparent"
	        ExtendClientAreaToDecorationsHint="True"
	        ExtendClientAreaTitleBarHeightHint="0"
	        WindowDecorations="BorderOnly"
	        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#08111F" />
        <SolidColorBrush x:Key="OuterFrameBrush" Color="#1E2D45" />
        <SolidColorBrush x:Key="RailBrush" Color="#0F1A2E" />
        <SolidColorBrush x:Key="PanelBrush" Color="#111C31" />
        <SolidColorBrush x:Key="SubtlePanelBrush" Color="#16233A" />
        <SolidColorBrush x:Key="ElevatedPanelBrush" Color="#10192B" />
        <SolidColorBrush x:Key="CardBrush" Color="#10192B" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#1C2D49" />
        <SolidColorBrush x:Key="PanelEdgeBrush" Color="#233653" />
        <SolidColorBrush x:Key="PanelEdgeStrongBrush" Color="#2C3E5E" />
        <SolidColorBrush x:Key="FaintBorderBrush" Color="#7A8AA655" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#201A38" />
        <SolidColorBrush x:Key="AccentGlowBrush" Color="#477C5CFF" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ChipBrush" Color="#1B2640" />
        <SolidColorBrush x:Key="ToolbarBrush" Color="#172743" />
        <SolidColorBrush x:Key="ToolbarHoverBrush" Color="#1C2D49" />
        <SolidColorBrush x:Key="OverlayBrush" Color="#B708111F" />
        <SolidColorBrush x:Key="PositiveBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="InfoBrush" Color="#0EA5E9" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#6A334A" />
        <SolidColorBrush x:Key="DangerFillBrush" Color="#3D1F2C" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#142038" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Button.momentCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.momentCard /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.momentCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Opacity" Value="0.97" />
        </Style>
        <Style Selector="Button.momentCard:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.momentCard:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.clickBlock">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.clickBlock /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.clickBlock:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
        </Style>
        <Style Selector="Button.nav:pointerover TextBlock.navTitle">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="TextBlock.navSectionHeader">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>
        <Style Selector="TextBlock.navTitle">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style Selector="TextBlock.navSubtitle">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style Selector="PathIcon.navIcon">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.navItem">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.navAccent">
            <Setter Property="Width" Value="3" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>
        <Style Selector="Button.toolbar">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FaintBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.toolbar:pointerover">
            <Setter Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="Button.toolbar:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="Button.toolbar:pressed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="Button.topCommand">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="42" />
        </Style>
        <Style Selector="Button.topCommand:pointerover">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.topCommand:pressed">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.topCommand:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.shellControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.shellControl:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
        </Style>
        <Style Selector="Button.shellControl:pressed">
            <Setter Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
        </Style>
        <Style Selector="Button.shellControl:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.shellControl:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.shellControl.close:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerFillBrush}" />
        </Style>
        <Style Selector="Button.detailPrimary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Button.detailSecondary">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FaintBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Button.detailDanger">
            <Setter Property="Background" Value="{DynamicResource DangerFillBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Border.overviewMetric">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FaintBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.overviewPanel">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FaintBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.infoChip">
            <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FaintBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="ComboBox.filter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="42" />
        </Style>
        <Style Selector="ComboBox.filter:pointerover">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter:pressed">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter:focus">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter:dropdownopen">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeStrongBrush}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ComboBox.filter:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter:focus /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter:dropdownopen /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter /template/ ToggleButton">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox.filter /template/ ToggleButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox.filter /template/ ToggleButton:pressed">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox.filter /template/ Path">
            <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox#DateFilterComboBox /template/ Border#Background, ComboBox#TypeFilterComboBox /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeStrongBrush}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ComboBox#DateFilterComboBox:pointerover /template/ Border#Background, ComboBox#TypeFilterComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox#DateFilterComboBox:focus /template/ Border#Background, ComboBox#TypeFilterComboBox:focus /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox#DateFilterComboBox:dropdownopen /template/ Border#Background, ComboBox#TypeFilterComboBox:dropdownopen /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox#DateFilterComboBox /template/ ToggleButton, ComboBox#TypeFilterComboBox /template/ ToggleButton">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox#DateFilterComboBox /template/ ContentPresenter, ComboBox#TypeFilterComboBox /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox#DateFilterComboBox /template/ Path, ComboBox#TypeFilterComboBox /template/ Path">
            <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="TextBox.searchBox /template/ TextBlock#watermark">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBox.searchBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="TextBox.searchBox:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.searchBox:focus">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.searchBox /template/ Border#border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.searchBox:focus /template/ Border#border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.searchBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.searchBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.noteBox">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentGlowBrush}" />
        </Style>
        <Style Selector="TextBox.noteBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBox.noteBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBox.noteBox /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeStrongBrush}" />
        </Style>
        <Style Selector="TextBox.noteBox:focus /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBox.noteBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeStrongBrush}" />
        </Style>
        <Style Selector="TextBox.noteBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Margin" Value="8,0,4,0" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10" />
            <Setter Property="MinHeight" Value="10" />
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        </Style>
        <Style Selector="ScrollBar /template/ Button">
            <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ScrollBar:pointerover /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
        </Style>
        <Style Selector="Thumb.ScrollBarThumb">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Thumb.ScrollBarThumb:pointerover">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Thumb.ScrollBarThumb:pressed">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="Fill" Value="{DynamicResource ScrollTrackBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="RepeatButton.ScrollBarPageButton">
            <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
        </Style>
        <Style Selector="TabControl.detailTabs TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TabControl.detailTabs TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource SubtlePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="Border.previewExpandButton">
            <Setter Property="Background" Value="#CC08111F" />
            <Setter Property="BorderBrush" Value="{DynamicResource FaintBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="8" />
        </Style>
        <Style Selector="Border.previewExpandButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
    </Window.Styles>
    <Grid>
    <Border x:Name="OuterShell"
            Margin="0"
            Background="{DynamicResource PageBackgroundBrush}"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="0"
            Padding="20,16,8,16">
    <Grid ColumnDefinitions="296,*">
        <Border x:Name="RailSurface"
                Grid.Column="0"
                MinWidth="296"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0"
                Padding="14,14,14,14"
                Margin="0,0,12,0"
                PointerPressed="ToolbarDragRegion_PointerPressed">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Image Width="42"
                               Height="42"
                               Source="avares://MomentTrace.Desktop/Assets/MomentTrace.png"
                               Stretch="Uniform" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="MomentTrace"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Your memory timeline"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="0">
                    <TextBlock Text="WORKSPACE"
                               Classes="navSectionHeader" />
                    <Border x:Name="TimelineNavHighlight" Classes="navItem">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border x:Name="TimelineNavAccent" Classes="navAccent" />
                            <Button x:Name="TimelineNavButton"
                                    Classes="nav"
                                    Grid.Column="1"
                                    Click="TimelineNavButton_Click"
                                    HorizontalContentAlignment="Stretch">
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                                    <PathIcon x:Name="TimelineNavIcon"
                                              Classes="navIcon"
                                              Foreground="{DynamicResource AccentBrush}"
                                              Data="M13,3 C8.03,3 4,7.03 4,12 L1.7,12 L4.7,15 L7.7,12 L5.5,12 C5.5,7.86 8.86,4.5 13,4.5 C17.14,4.5 20.5,7.86 20.5,12 C20.5,16.14 17.14,19.5 13,19.5 C10.93,19.5 9.06,18.66 7.7,17.3 L6.64,18.36 C8.27,19.99 10.52,21 13,21 C17.97,21 22,16.97 22,12 C22,7.03 17.97,3 13,3 Z M12,7 L13.5,7 L13.5,12.2 L17.2,14.4 L16.45,15.7 L12,13 Z" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                        <TextBlock x:Name="TimelineNavTitle" Text="Timeline" Classes="navTitle" />
                                        <TextBlock x:Name="TimelineNavSubtitle"
                                                   Text="Moments today"
                                                   Classes="navSubtitle" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>
                    <Border x:Name="OverviewNavHighlight" Classes="navItem">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border x:Name="OverviewNavAccent" Classes="navAccent" />
                            <Button x:Name="OverviewNavButton"
                                    Classes="nav"
                                    Grid.Column="1"
                                    Click="OverviewNavButton_Click"
                                    HorizontalContentAlignment="Stretch">
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                                    <PathIcon x:Name="OverviewNavIcon"
                                              Classes="navIcon"
                                              Foreground="{DynamicResource MutedTextBrush}"
                                              Data="M3,3 L11,3 L11,11 L3,11 Z M13,3 L21,3 L21,9 L13,9 Z M3,13 L9,13 L9,21 L3,21 Z M11,13 L21,13 L21,21 L11,21 Z" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                        <TextBlock x:Name="OverviewNavTitle" Text="Overview" Classes="navTitle" />
                                        <TextBlock x:Name="OverviewNavSubtitle" Text="Daily summary" Classes="navSubtitle" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="2"
                              Margin="0,20,0,0"
                              Padding="0"
                              AllowAutoHide="False"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="0">
                            <TextBlock Text="LIBRARY"
                                       Classes="navSectionHeader" />
                            <Border x:Name="SavedMomentsNavHighlight" Classes="navItem">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border x:Name="SavedMomentsNavAccent" Classes="navAccent" />
                                    <Button x:Name="SavedMomentsNavButton"
                                            Classes="nav"
                                            Grid.Column="1"
                                            Click="SavedMomentsNavButton_Click"
                                            HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                                            <PathIcon x:Name="SavedMomentsNavIcon"
                                                      Classes="navIcon"
                                                      Foreground="{DynamicResource MutedTextBrush}"
                                                      Data="M12,2 L14.96,8.33 L22,9.27 L16.9,14.18 L18.18,21.1 L12,17.77 L5.82,21.1 L7.1,14.18 L2,9.27 L9.04,8.33 Z" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                                <TextBlock x:Name="SavedMomentsNavTitle" Text="Saved Moments" Classes="navTitle" />
                                                <TextBlock x:Name="SavedMomentsNavSubtitle" Text="Pinned and bookmarked" Classes="navSubtitle" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                            <Border x:Name="NotesNavHighlight" Classes="navItem">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border x:Name="NotesNavAccent" Classes="navAccent" />
                                    <Button x:Name="NotesNavButton"
                                            Classes="nav"
                                            Grid.Column="1"
                                            Click="NotesNavButton_Click"
                                            HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                                            <PathIcon x:Name="NotesNavIcon"
                                                      Classes="navIcon"
                                                      Foreground="{DynamicResource MutedTextBrush}"
                                                      Data="M6,2 L14,2 L20,8 L20,20 C20,21.1 19.1,22 18,22 L6,22 C4.9,22 4,21.1 4,20 L4,4 C4,2.9 4.9,2 6,2 Z M13,3.5 L13,9 L18.5,9 Z M7,12 L17,12 L17,13.5 L7,13.5 Z M7,15.5 L17,15.5 L17,17 L7,17 Z M7,19 L14,19 L14,20.5 L7,20.5 Z" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                                <TextBlock x:Name="NotesNavTitle" Text="Notes" Classes="navTitle" />
                                                <TextBlock x:Name="NotesNavSubtitle" Text="Moments with notes" Classes="navSubtitle" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                            <Border x:Name="BookmarksNavHighlight" Classes="navItem">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border x:Name="BookmarksNavAccent" Classes="navAccent" />
                                    <Button x:Name="BookmarksNavButton"
                                            Classes="nav"
                                            Grid.Column="1"
                                            Click="BookmarksNavButton_Click"
                                            HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                                            <PathIcon x:Name="BookmarksNavIcon"
                                                      Classes="navIcon"
                                                      Foreground="{DynamicResource MutedTextBrush}"
                                                      Data="M7,3 L17,3 C18.1,3 19,3.9 19,5 L19,22 L12,19 L5,22 L5,5 C5,3.9 5.9,3 7,3 Z" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                                <TextBlock x:Name="BookmarksNavTitle" Text="Bookmarks" Classes="navTitle" />
                                                <TextBlock x:Name="BookmarksNavSubtitle" Text="Saved for later" Classes="navSubtitle" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="0">
                            <TextBlock Text="SOURCES"
                                       Classes="navSectionHeader" />
                            <Border x:Name="AppsNavHighlight" Classes="navItem">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border x:Name="AppsNavAccent" Classes="navAccent" />
                                    <Button x:Name="AppsNavButton"
                                            Classes="nav"
                                            Grid.Column="1"
                                            Click="AppsNavButton_Click"
                                            HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                                            <PathIcon x:Name="AppsNavIcon"
                                                      Classes="navIcon"
                                                      Foreground="{DynamicResource MutedTextBrush}"
                                                      Data="M4,4 L10,4 L10,10 L4,10 Z M14,4 L20,4 L20,10 L14,10 Z M4,14 L10,14 L10,20 L4,20 Z M14,14 L20,14 L20,20 L14,20 Z" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                                <TextBlock x:Name="AppsNavTitle" Text="Apps" Classes="navTitle" />
                                                <TextBlock x:Name="AppsNavSubtitle" Text="Desktop and tools" Classes="navSubtitle" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                            <Border x:Name="WebsitesNavHighlight" Classes="navItem">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border x:Name="WebsitesNavAccent" Classes="navAccent" />
                                    <Button x:Name="WebsitesNavButton"
                                            Classes="nav"
                                            Grid.Column="1"
                                            Click="WebsitesNavButton_Click"
                                            HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                                            <PathIcon x:Name="WebsitesNavIcon"
                                                      Classes="navIcon"
                                                      Foreground="{DynamicResource MutedTextBrush}"
                                                      Data="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M18.93,8 L15.98,8 C15.65,6.7 15.14,5.48 14.47,4.48 C16.37,5.12 17.95,6.38 18.93,8 Z M12,4.04 C12.83,5.24 13.48,6.56 13.82,8 L10.18,8 C10.52,6.56 11.17,5.24 12,4.04 Z M4.26,14 C4.09,13.36 4,12.69 4,12 C4,11.31 4.09,10.64 4.26,10 L7.64,10 C7.56,10.66 7.5,11.32 7.5,12 C7.5,12.68 7.56,13.34 7.64,14 Z M5.07,16 L8.02,16 C8.35,17.3 8.86,18.52 9.53,19.52 C7.63,18.88 6.05,17.62 5.07,16 Z M8.02,8 L5.07,8 C6.05,6.38 7.63,5.12 9.53,4.48 C8.86,5.48 8.35,6.7 8.02,8 Z M12,19.96 C11.17,18.76 10.52,17.44 10.18,16 L13.82,16 C13.48,17.44 12.83,18.76 12,19.96 Z M14.25,14 L9.75,14 C9.66,13.34 9.6,12.68 9.6,12 C9.6,11.32 9.66,10.66 9.75,10 L14.25,10 C14.34,10.66 14.4,11.32 14.4,12 C14.4,12.68 14.34,13.34 14.25,14 Z M14.47,19.52 C15.14,18.52 15.65,17.3 15.98,16 L18.93,16 C17.95,17.62 16.37,18.88 14.47,19.52 Z M16.36,14 C16.44,13.34 16.5,12.68 16.5,12 C16.5,11.32 16.44,10.66 16.36,10 L19.74,10 C19.91,10.64 20,11.31 20,12 C20,12.69 19.91,13.36 19.74,14 Z" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                                <TextBlock x:Name="WebsitesNavTitle" Text="Websites" Classes="navTitle" />
                                                <TextBlock x:Name="WebsitesNavSubtitle" Text="Browser activity" Classes="navSubtitle" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                            <Border x:Name="FilesNavHighlight" Classes="navItem">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border x:Name="FilesNavAccent" Classes="navAccent" />
                                    <Button x:Name="FilesNavButton"
                                            Classes="nav"
                                            Grid.Column="1"
                                            Click="FilesNavButton_Click"
                                            HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                                            <PathIcon x:Name="FilesNavIcon"
                                                      Classes="navIcon"
                                                      Foreground="{DynamicResource MutedTextBrush}"
                                                      Data="M10,4 L12,6 L20,6 C21.1,6 22,6.9 22,8 L22,18 C22,19.1 21.1,20 20,20 L4,20 C2.9,20 2,19.1 2,18 L2,6 C2,4.9 2.9,4 4,4 Z" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                                <TextBlock x:Name="FilesNavTitle" Text="Files" Classes="navTitle" />
                                                <TextBlock x:Name="FilesNavSubtitle" Text="Documents and paths" Classes="navSubtitle" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- User profile rail section: commented out for now; revisit account/identity UI later. -->
                <!--
                <Border Grid.Row="3"
                        Margin="0,16,0,0"
                        Background="{DynamicResource ElevatedPanelBrush}"
                        BorderBrush="{DynamicResource FaintBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                        <Border Width="36"
                                Height="36"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="18">
                            <TextBlock x:Name="ProfileInitialText"
                                       Text="B"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2"
                                    MinWidth="0">
                            <TextBlock x:Name="ProfileNameText"
                                       Text="blakb"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Local workspace"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="11" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="›"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                        <Button Classes="shellControl"
                                ToolTip.Tip="Settings"
                                Width="36"
                                Height="36">
                            <TextBlock Text="⚙"
                                       FontSize="14"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Button>
                    </Grid>
                </Border>
                -->
                <Border x:Name="SettingsNavHighlight"
                        Grid.Row="3"
                        Classes="navItem"
                        Margin="0,16,0,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border x:Name="SettingsNavAccent" Classes="navAccent" />
                        <Button x:Name="SettingsNavButton"
                                Classes="nav"
                                Grid.Column="1"
                                Click="SettingsNavButton_Click"
                                HorizontalContentAlignment="Stretch"
                                ToolTip.Tip="Settings">
                            <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                                <PathIcon x:Name="SettingsNavIcon"
                                          Classes="navIcon"
                                          Foreground="{DynamicResource MutedTextBrush}"
                                          Data="M19.43,12.98 C19.47,12.66 19.5,12.34 19.5,12 C19.5,11.66 19.47,11.33 19.42,11.02 L21.54,9.37 L19.54,5.9 L17.04,6.9 C16.53,6.51 15.98,6.19 15.36,5.94 L15,3.28 L11,3.28 L10.64,5.94 C10.02,6.19 9.46,6.52 8.96,6.9 L6.46,5.9 L4.46,9.37 L6.58,11.02 C6.53,11.33 6.5,11.66 6.5,12 C6.5,12.34 6.53,12.66 6.58,12.98 L4.46,14.63 L6.46,18.1 L8.96,17.1 C9.47,17.49 10.02,17.81 10.64,18.06 L11,20.72 L15,20.72 L15.36,18.06 C15.98,17.81 16.54,17.48 17.04,17.1 L19.54,18.1 L21.54,14.63 Z M13,15.5 C11.07,15.5 9.5,13.93 9.5,12 C9.5,10.07 11.07,8.5 13,8.5 C14.93,8.5 16.5,10.07 16.5,12 C16.5,13.93 14.93,15.5 13,15.5 Z" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                    <TextBlock x:Name="SettingsNavTitle" Text="Settings" Classes="navTitle" />
                                    <TextBlock x:Name="SettingsNavSubtitle"
                                               Text="Privacy, startup, and local data"
                                               Classes="navSubtitle" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="0"
                HorizontalAlignment="Right"
                Width="1"
                Margin="0,8,10,8"
                Background="{DynamicResource PanelEdgeBrush}" />

        <Grid Grid.Column="1"
              RowDefinitions="48,*"
              Margin="0,0,0,0">
            <Border x:Name="TopCommandSurface"
                    Margin="12,4,4,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0,0,0,0"
                    PointerPressed="ToolbarDragRegion_PointerPressed">
                    <Grid ColumnDefinitions="*,142,96,50,50,50"
                          ColumnSpacing="12"
                          VerticalAlignment="Center">
                        <Border x:Name="SearchSurface"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource PanelEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="14,8"
                                MinHeight="40">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock x:Name="SearchIconText"
                                           Text="⌕"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           FontSize="20"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="SearchTextBox"
                                         Classes="searchBox"
                                         Grid.Column="1"
                                         TextChanged="SearchTextBox_TextChanged"
                                         GotFocus="SearchTextBox_GotFocus"
                                         LostFocus="SearchTextBox_LostFocus"
                                         PlaceholderText="Search moments, sessions, apps, or websites..."
                                         PlaceholderForeground="{DynamicResource SubtleTextBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextBrush}" />
                            </Grid>
                        </Border>
                        <ComboBox x:Name="DateFilterComboBox"
                                  Classes="filter"
                                  Grid.Column="1"
                                  SelectionChanged="DateFilterComboBox_SelectionChanged"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  MinHeight="40" />
                        <ComboBox x:Name="TypeFilterComboBox"
                                  Classes="filter"
                                  Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  MinHeight="40" />
                        <Button x:Name="MinimizeShellButton"
                                Grid.Column="3"
                                Classes="shellControl"
                                Click="MinimizeShellButton_Click"
                                ToolTip.Tip="Minimize"
                                Width="48">
                            <TextBlock Text="−"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Button>
                        <Button x:Name="MaximizeShellButton"
                                Grid.Column="4"
                                Classes="shellControl"
                                Click="MaximizeShellButton_Click"
                                ToolTip.Tip="Maximize"
                                Width="48">
                            <TextBlock Text="□"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Button>
                        <Button x:Name="CloseShellButton"
                                Grid.Column="5"
                                Classes="shellControl close"
                                Click="CloseShellButton_Click"
                                ToolTip.Tip="Close"
                                Width="48">
                            <TextBlock Text="×"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Button>
                    </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Panel x:Name="TimelinePage" Margin="12,8,4,0">
                    <Grid x:Name="TimelineContentGrid"
                          ClipToBounds="True">
                    <Grid MinWidth="0"
                          ClipToBounds="True"
                          RowDefinitions="Auto,Auto,*">
                            <StackPanel Margin="0,0,0,20"
                                        Spacing="0">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                    <TextBlock Text="Timeline"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                    <Border Classes="infoChip"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TimelineCountText"
                                                   Text="Moments"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="13"
                                                   Margin="0,2,0,0" />
                                    </Border>
                                    <Border Classes="infoChip"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Stored locally · Only visible to you"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TimelineSubtitleText"
                                           Text="Grouped into local moments and arranged along a shared activity rail."
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           FontSize="13"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="TimelineFocusBanner"
                                    Grid.Row="1"
                                    IsVisible="False"
                                    Background="{DynamicResource ElevatedPanelBrush}"
                                    BorderBrush="{DynamicResource FaintBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14,12"
                                    Margin="0,0,12,14">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">
                                    <TextBlock x:Name="TimelineFocusBannerText"
                                               Text="Timeline is focused to a time range."
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="TimelineFocusClearButton"
                                            Grid.Column="1"
                                            Classes="toolbar"
                                            Click="TimelineFocusClearButton_Click"
                                            Padding="10,6"
                                            MinWidth="92">
                                        <TextBlock Text="Clear focus"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="2">
                            <ScrollViewer x:Name="TimelineScrollViewer"
                                          AllowAutoHide="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          ClipToBounds="True">
                                <ItemsControl x:Name="TimelineGroupsItems"
                                              Margin="0,0,12,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="36,*" Margin="0,0,0,24">
                                                <Grid>
                                                    <Border Width="2"
                                                            Background="{DynamicResource PanelEdgeBrush}"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,28,0,0" />
                                                    <Border Width="16"
                                                            Height="16"
                                                            CornerRadius="8"
                                                            Background="{Binding AccentBrush}"
                                                            BorderBrush="{DynamicResource PanelBrush}"
                                                            BorderThickness="2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Top"
                                                            Margin="0,12,0,0" />
                                                </Grid>
                                                    <StackPanel Grid.Column="1" Spacing="16">
                                                    <Grid ColumnDefinitions="104,*" ColumnSpacing="12">
                                                        <Border Background="{Binding AccentBrush}"
                                                                CornerRadius="12"
                                                                Padding="9,3"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding TimeRange}"
                                                                       Foreground="White"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding Name}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontSize="15"
                                                                           FontWeight="SemiBold" />
                                                                <Border Classes="infoChip"
                                                                        Margin="10,-1,0,0"
                                                                        VerticalAlignment="Top">
                                                                    <TextBlock Text="{Binding CountLabel}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold" />
                                                                </Border>
                                                             </StackPanel>
                                                             <TextBlock Text="{Binding Summary}"
                                                                        Foreground="{DynamicResource MutedTextBrush}"
                                                                        Margin="0,7,0,0"
                                                                        FontSize="12"
                                                                        TextWrapping="Wrap" />
                                                         </StackPanel>
                                                     </Grid>
                                                    <ItemsControl ItemsSource="{Binding Moments}"
                                                                  IsVisible="{Binding ShowCards}"
                                                                  Margin="0,2,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Click="TimelineMomentButton_Click"
                                                                        Classes="momentCard"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="0"
                                                                        Margin="0,0,12,12"
                                                                        HorizontalAlignment="Stretch">
                                                                        <Border Width="218"
                                                                                Height="150"
                                                                                Background="{Binding CardBackground}"
                                                                                BorderBrush="{Binding BorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="8"
                                                                                Padding="0">
                                                                            <Grid RowDefinitions="82,*">
                                                                                <Border Background="{DynamicResource ElevatedPanelBrush}"
                                                                                        CornerRadius="8"
                                                                                        Padding="0"
                                                                                        ClipToBounds="True">
                                                                                    <Grid>
                                                                                        <controls:DeferredImage SourcePath="{Binding PreviewPath}"
                                                                                                                Stretch="UniformToFill"
                                                                                                                IsVisible="{Binding ShowPreviewImage}" />
                                                                                        <Border Background="{DynamicResource ElevatedPanelBrush}"
                                                                                                IsVisible="{Binding ShowHeroIcon}">
                                                                                            <controls:DeferredImage SourcePath="{Binding IconPath}"
                                                                                                                    Width="58"
                                                                                                                    Height="58"
                                                                                                                    Stretch="Uniform"
                                                                                                                    HorizontalAlignment="Center"
                                                                                                                    VerticalAlignment="Center" />
                                                                                        </Border>
                                                                                        <Border Background="{DynamicResource ElevatedPanelBrush}"
                                                                                                IsVisible="{Binding ShowGlyphFallback}" />
                                                                                        <Border HorizontalAlignment="Right"
                                                                                                Background="{DynamicResource SubtlePanelBrush}"
                                                                                                CornerRadius="5"
                                                                                                Padding="6,2"
                                                                                                Margin="0,8,8,0"
                                                                                                VerticalAlignment="Top">
                                                                                            <TextBlock Text="{Binding TimeLabel}"
                                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                                       FontSize="11"
                                                                                                       FontWeight="SemiBold" />
                                                                                        </Border>
                                                                                        <Border Width="60"
                                                                                                Height="60"
                                                                                                CornerRadius="16"
                                                                                                Background="{Binding GlyphBackground}"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                IsVisible="{Binding ShowGlyphFallback}">
                                                                                            <TextBlock Text="{Binding Glyph}"
                                                                                                       Foreground="{Binding GlyphForeground}"
                                                                                                       FontSize="20"
                                                                                                       FontWeight="Bold"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       VerticalAlignment="Center" />
                                                                                        </Border>
                                                                                        <Border HorizontalAlignment="Right"
                                                                                                VerticalAlignment="Bottom"
                                                                                                Margin="0,0,8,8"
                                                                                                Background="{DynamicResource SubtlePanelBrush}"
                                                                                                CornerRadius="5"
                                                                                                Padding="6,2">
                                                                                            <TextBlock Text="{Binding SeenLabel}"
                                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                                       FontSize="11"
                                                                                                       FontWeight="SemiBold" />
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </Border>
                                                                                <Grid Grid.Row="1"
                                                                                      Margin="10,8,10,8"
                                                                                      RowDefinitions="Auto,Auto">
                                                                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                                                                          ColumnSpacing="7">
                                                                                        <Border Width="18"
                                                                                                Height="18"
                                                                                                CornerRadius="0"
                                                                                                Background="Transparent"
                                                                                                VerticalAlignment="Top">
                                                                                            <Grid>
                                                                                                <controls:DeferredImage SourcePath="{Binding IconPath}"
                                                                                                                        Width="16"
                                                                                                                        Height="16"
                                                                                                                        Stretch="Uniform"
                                                                                                                        IsVisible="{Binding ShowSmallIcon}"
                                                                                                                        HorizontalAlignment="Center"
                                                                                                                        VerticalAlignment="Center" />
                                                                                                <TextBlock Text="{Binding Glyph}"
                                                                                                           Foreground="{Binding GlyphForeground}"
                                                                                                           FontSize="10"
                                                                                                           FontWeight="SemiBold"
                                                                                                           IsVisible="{Binding ShowSmallGlyph}"
                                                                                                           HorizontalAlignment="Center"
                                                                                                           VerticalAlignment="Center" />
                                                                                            </Grid>
                                                                                        </Border>
                                                                                        <TextBlock Grid.Column="1"
                                                                                                   Text="{Binding Title}"
                                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                                   FontWeight="SemiBold"
                                                                                                   TextWrapping="Wrap"
                                                                                                   FontSize="13"
                                                                                                   MaxWidth="154"
                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                        <Border Grid.Column="2"
                                                                                                Classes="previewExpandButton"
                                                                                                Width="28"
                                                                                                Height="28"
                                                                                                Margin="0,-4,0,0"
                                                                                                IsVisible="{Binding ShowPreviewImage}"
                                                                                                PointerPressed="TimelinePreviewExpandButton_PointerPressed"
                                                                                                Tag="{Binding Id}"
                                                                                                ToolTip.Tip="Expand preview">
                                                                                            <TextBlock Text="⤢"
                                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                                       FontSize="14"
                                                                                                       FontWeight="SemiBold"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       VerticalAlignment="Center" />
                                                                                        </Border>
                                                                                    </Grid>
                                                                                    <TextBlock Grid.Row="1"
                                                                                               Text="{Binding Subtitle}"
                                                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                                                               Margin="25,2,0,0"
                                                                                               FontSize="12"
                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                </Grid>
                                                                            </Grid>
                                                                        </Border>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding Moments}"
                                                                  IsVisible="{Binding ShowList}"
                                                                  Margin="0,0,12,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Click="TimelineMomentButton_Click"
                                                                        Classes="momentCard"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="0"
                                                                        Margin="0,0,0,10"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Stretch">
                                                                    <Border MinHeight="78"
                                                                            Background="{Binding CardBackground}"
                                                                            BorderBrush="{Binding BorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="9"
                                                                            Padding="10">
                                                                        <Grid ColumnDefinitions="64,*,Auto"
                                                                              ColumnSpacing="12">
                                                                            <Border Width="56"
                                                                                    Height="56"
                                                                                    Background="{DynamicResource ElevatedPanelBrush}"
                                                                                    CornerRadius="8"
                                                                                    ClipToBounds="True"
                                                                                    VerticalAlignment="Center">
                                                                                <Grid>
                                                                                    <controls:DeferredImage SourcePath="{Binding PreviewPath}"
                                                                                                            Stretch="UniformToFill"
                                                                                                            IsVisible="{Binding ShowPreviewImage}" />
                                                                                    <controls:DeferredImage SourcePath="{Binding IconPath}"
                                                                                                            Width="36"
                                                                                                            Height="36"
                                                                                                            Stretch="Uniform"
                                                                                                            IsVisible="{Binding ShowHeroIcon}"
                                                                                                            HorizontalAlignment="Center"
                                                                                                            VerticalAlignment="Center" />
                                                                                    <Border Width="36"
                                                                                            Height="36"
                                                                                            CornerRadius="10"
                                                                                            Background="{Binding GlyphBackground}"
                                                                                            IsVisible="{Binding ShowGlyphFallback}"
                                                                                            HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding Glyph}"
                                                                                                   Foreground="{Binding GlyphForeground}"
                                                                                                   FontSize="14"
                                                                                                   FontWeight="Bold"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center" />
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Border>
                                                                            <StackPanel Grid.Column="1"
                                                                                        VerticalAlignment="Center">
                                                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                                                      ColumnSpacing="8">
                                                                                    <controls:DeferredImage SourcePath="{Binding IconPath}"
                                                                                                            Width="16"
                                                                                                            Height="16"
                                                                                                            Stretch="Uniform"
                                                                                                            IsVisible="{Binding ShowSmallIcon}"
                                                                                                            VerticalAlignment="Center" />
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding Title}"
                                                                                               Foreground="{DynamicResource TextBrush}"
                                                                                               FontWeight="SemiBold"
                                                                                               FontSize="13"
                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                    <Border Grid.Column="2"
                                                                                            Background="{Binding KindBackground}"
                                                                                            CornerRadius="8"
                                                                                            Padding="8,2"
                                                                                            VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding KindLabel}"
                                                                                                   Foreground="{Binding KindForeground}"
                                                                                                   FontSize="10"
                                                                                                   FontWeight="SemiBold" />
                                                                                    </Border>
                                                                                </Grid>
                                                                                <TextBlock Text="{Binding Subtitle}"
                                                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                                                           Margin="0,5,0,0"
                                                                                           FontSize="12"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Text="{Binding Meta}"
                                                                                           Foreground="{DynamicResource SubtleTextBrush}"
                                                                                           Margin="0,4,0,0"
                                                                                           FontSize="11"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="2"
                                                                                        VerticalAlignment="Center"
                                                                                        HorizontalAlignment="Right">
                                                                                <TextBlock Text="{Binding TimeLabel}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontSize="12"
                                                                                           FontWeight="SemiBold"
                                                                                           HorizontalAlignment="Right" />
                                                                                <Border Background="{DynamicResource ToolbarBrush}"
                                                                                        CornerRadius="6"
                                                                                        Padding="7,2"
                                                                                        Margin="0,7,0,0">
                                                                                    <TextBlock Text="{Binding SeenLabel}"
                                                                                               Foreground="{DynamicResource TextBrush}"
                                                                                               FontSize="11"
                                                                                               FontWeight="SemiBold" />
                                                                                </Border>
                                                                                <Border Classes="previewExpandButton"
                                                                                        Width="28"
                                                                                        Height="28"
                                                                                        Margin="0,8,0,0"
                                                                                        IsVisible="{Binding ShowPreviewImage}"
                                                                                        PointerPressed="TimelinePreviewExpandButton_PointerPressed"
                                                                                        Tag="{Binding Id}"
                                                                                        ToolTip.Tip="Expand preview"
                                                                                        HorizontalAlignment="Right">
                                                                                    <TextBlock Text="⤢"
                                                                                               Foreground="{DynamicResource TextBrush}"
                                                                                               FontSize="14"
                                                                                               FontWeight="SemiBold"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button IsVisible="{Binding HasExpandablePreview}"
                                                            Click="TimelineGroupToggleButton_Click"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            HorizontalAlignment="Left"
                                                            Padding="0"
                                                            Margin="0,2,0,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding ToggleText}"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ToggleGlyph}"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Border x:Name="TimelineEmptyState"
                                    IsVisible="False"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource FaintBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="22"
                                    Margin="0,6,12,0"
                                    VerticalAlignment="Top">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="TimelineEmptyTitleText"
                                               Text="No moments yet"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="TimelineEmptyDetailText"
                                               Text="Captured activity will appear here once local moments are available."
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               LineHeight="19" />
                                    <Button x:Name="TimelineEmptyActionButton"
                                            Classes="toolbar"
                                            Click="TimelineEmptyActionButton_Click"
                                            IsVisible="False"
                                            HorizontalAlignment="Left"
                                            Margin="0,6,0,0"
                                            Padding="12,7">
                                        <TextBlock x:Name="TimelineEmptyActionButtonText"
                                                   Text="Show all activity"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Border x:Name="DetailScrim"
                            IsVisible="False"
                            Background="#9908111F"
                            PointerPressed="CloseDetailButton_Click" />
                    <Border x:Name="DetailSurface"
                            IsVisible="False"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Width="400"
                            Margin="0,0,0,12"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0">
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource FaintBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,14,14,12">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid ColumnDefinitions="44,*,Auto"
                                      ColumnSpacing="10">
                                    <Border x:Name="DetailGlyphHost"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="10"
                                            Background="{DynamicResource SubtlePanelBrush}">
                                        <Grid>
                                            <Image x:Name="DetailIconImage"
                                                   Width="30"
                                                   Height="30"
                                                   Stretch="Uniform"
                                                   IsVisible="False"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                            <TextBlock x:Name="DetailGlyphText"
                                                       Text="MT"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <TextBlock x:Name="DetailTitleText"
                                                   Text="Select a moment"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="DetailSubtitleText"
                                                   Text="Click a moment to inspect it"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="CloseDetailButton"
                                            Grid.Column="2"
                                            Classes="shellControl"
                                            Click="CloseDetailButton_Click"
                                            ToolTip.Tip="Close"
                                            Width="34"
                                            Height="34"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="×"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </Button>
                                </Grid>
                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="0,12,0,12">
                                    <Button x:Name="OpenMomentButton"
                                            Classes="detailPrimary"
                                            Click="OpenMomentButton_Click"
                                            Padding="12,7">
                                        <TextBlock Text="Open"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Button>
                                    <Button x:Name="PinMomentButton"
                                            Classes="detailSecondary"
                                            Click="PinMomentButton_Click"
                                            Padding="10,7">
                                        <TextBlock x:Name="PinMomentButtonText"
                                                   Text="Pin"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Button>
                                    <Button x:Name="BookmarkMomentButton"
                                            Classes="detailSecondary"
                                            Click="BookmarkMomentButton_Click"
                                            Padding="10,7">
                                        <TextBlock x:Name="BookmarkMomentButtonText"
                                                   Text="Bookmark"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Button>
                                    <Button x:Name="DeleteMomentButton"
                                            Classes="detailDanger"
                                            Click="DeleteMomentButton_Click"
                                            Width="34"
                                            Height="34"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center">
                                        <TextBlock Text=""
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                                <ScrollViewer x:Name="OverviewDetailTabContent"
                                              Grid.Row="2"
                                              AllowAutoHide="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="14"
                                                Margin="0,0,4,0">
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="OverviewNarrativeHeaderText"
                                                       Text="Summary"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <Border x:Name="OverviewNarrativeSection"
                                                    Background="{DynamicResource SubtlePanelBrush}"
                                                    BorderBrush="{DynamicResource FaintBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12">
                                                <TextBlock x:Name="DetailNarrativeText"
                                                           Text="Select a moment to inspect its grouped activity."
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           LineHeight="18"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="PreviewHeaderText"
                                                       Text="Preview"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <Border x:Name="DetailPreviewSection">
                                                <Border x:Name="DetailPreviewHost"
                                                        Background="{DynamicResource SubtlePanelBrush}"
                                                        BorderBrush="{DynamicResource FaintBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        ClipToBounds="True"
                                                        Height="132"
                                                        IsVisible="False">
                                                    <Grid>
                                                        <Image x:Name="DetailPreviewImage"
                                                               Stretch="UniformToFill" />
                                                        <Border Classes="previewExpandButton"
                                                                Width="34"
                                                                Height="34"
                                                                PointerPressed="DetailPreviewExpandButton_PointerPressed"
                                                                ToolTip.Tip="Expand preview">
                                                            <TextBlock Text="⤢"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontSize="16"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="MetadataHeaderText"
                                                       Text="Details"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <Border x:Name="MetadataSection"
                                                    Background="{DynamicResource SubtlePanelBrush}"
                                                    BorderBrush="{DynamicResource FaintBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                                      ColumnDefinitions="Auto,*"
                                                      RowSpacing="8"
                                                      ColumnSpacing="12">
                                                    <TextBlock Text="Span"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11" />
                                                    <TextBlock Grid.Column="1"
                                                               x:Name="DetailMetaSpanText"
                                                               Text="Local only"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="1"
                                                               Text="From"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11" />
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="1"
                                                               x:Name="DetailMetaStartedText"
                                                               Text="Local only"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="2"
                                                               Text="Until"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11" />
                                                    <TextBlock Grid.Row="2"
                                                               Grid.Column="1"
                                                               x:Name="DetailMetaEndedText"
                                                               Text="Local only"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="3"
                                                               Text="Source"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11" />
                                                    <TextBlock Grid.Row="3"
                                                               Grid.Column="1"
                                                               x:Name="DetailMetaSourceText"
                                                               Text="MomentTrace"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="4"
                                                               Text="Category"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11" />
                                                    <Border Grid.Row="4"
                                                            Grid.Column="1"
                                                            Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="4"
                                                            HorizontalAlignment="Left"
                                                            Padding="6,2">
                                                        <TextBlock x:Name="DetailMetaCategoryText"
                                                                   Text="Moment"
                                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="NoteHeaderText"
                                                       Text="Note"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <Border x:Name="NoteSection"
                                                    Background="{DynamicResource SubtlePanelBrush}"
                                                    BorderBrush="{DynamicResource FaintBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12">
                                                <StackPanel Spacing="8">
                                                    <TextBox x:Name="MomentNoteTextBox"
                                                             Classes="noteBox"
                                                             Background="{DynamicResource PanelBrush}"
                                                             BorderBrush="{DynamicResource FaintBorderBrush}"
                                                             BorderThickness="1"
                                                             Foreground="{DynamicResource TextBrush}"
                                                             MinHeight="64"
                                                             Padding="10"
                                                             FontSize="12"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap" />
                                                    <Button x:Name="SaveNoteButton"
                                                            Classes="detailSecondary"
                                                            Click="SaveNoteButton_Click"
                                                            Padding="10,6"
                                                            HorizontalAlignment="Right">
                                                        <TextBlock Text="Save"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel x:Name="CapturedActivitySection"
                                                    Spacing="6"
                                                    IsVisible="False">
                                            <TextBlock x:Name="CapturedActivityHeaderText"
                                                       Text="Captured activity"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <Border Background="{DynamicResource SubtlePanelBrush}"
                                                    BorderBrush="{DynamicResource FaintBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12">
                                                <StackPanel Spacing="8">
                                                    <TextBlock x:Name="ActivityTabSummaryText"
                                                               Text="Select a moment to inspect its raw captured entries."
                                                               Foreground="{DynamicResource SubtleTextBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                    <ItemsControl x:Name="RawEntriesItems">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource PanelBrush}"
                                                                        BorderBrush="{DynamicResource FaintBorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Padding="10"
                                                                        Margin="0,0,0,6">
                                                                    <StackPanel Spacing="3">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding Source}"
                                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                                   FontSize="11"
                                                                                   TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding TimeRange}"
                                                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                                                   FontSize="10" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel x:Name="RelatedMomentsSection"
                                                    Spacing="6"
                                                    IsVisible="False">
                                            <TextBlock x:Name="RelatedMomentsHeaderText"
                                                       Text="Related"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <Border Background="{DynamicResource SubtlePanelBrush}"
                                                    BorderBrush="{DynamicResource FaintBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12">
                                                <StackPanel Spacing="8">
                                                    <TextBlock x:Name="RelatedSummaryText"
                                                               Text="No related moments yet"
                                                               Foreground="{DynamicResource SubtleTextBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                    <ItemsControl x:Name="RelatedMomentsItems">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource PanelBrush}"
                                                                        BorderBrush="{DynamicResource FaintBorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Padding="10"
                                                                        Margin="0,0,0,6">
                                                                    <StackPanel Spacing="3">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding Detail}"
                                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                                   FontSize="11"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Border>
                </Panel>
                </Grid>

            <ScrollViewer x:Name="OverviewPage" Grid.Row="1" IsVisible="False" AllowAutoHide="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="12,8,4,0">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2"
                                Margin="0,6,0,0">
                        <TextBlock x:Name="OverviewDateText"
                                   Text="Today"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="26"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="At a glance"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   FontSize="12" />
                        <TextBlock x:Name="OverviewLeadText"
                                   Text="A visual summary of the day"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12" />
                    </StackPanel>

                    <Border x:Name="OverviewEmptyDayBanner"
                            IsVisible="False"
                            Background="{DynamicResource ElevatedPanelBrush}"
                            BorderBrush="{DynamicResource FaintBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16,14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Quiet day so far"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Overview cards and charts stay visible, but this day has not produced captured moments yet. Switch dates or keep MomentTrace running to build your daily story."
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       MaxWidth="760" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="OverviewTimelineContextBanner"
                            IsVisible="False"
                            Background="{DynamicResource ElevatedPanelBrush}"
                            BorderBrush="{DynamicResource FaintBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="10">
                            <TextBlock x:Name="OverviewTimelineContextText"
                                       Text="Timeline is currently focused to a subset of the day."
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button x:Name="OverviewTimelineContextResumeButton"
                                    Grid.Column="1"
                                    Classes="toolbar"
                                    Click="OverviewTimelineContextResumeButton_Click"
                                    Padding="10,6"
                                    MinWidth="110">
                                <TextBlock Text="Resume timeline"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Button>
                            <Button x:Name="OverviewTimelineContextClearButton"
                                    Grid.Column="2"
                                    Classes="toolbar"
                                    Click="OverviewTimelineContextClearButton_Click"
                                    Padding="10,6"
                                    MinWidth="92">
                                <TextBlock Text="Clear"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Button>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="OverviewSummaryItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent"
                                        BorderThickness="0"
                                        Margin="0,0,12,12">
                                    <controls:SummaryMetricCard Label="{Binding Label}"
                                                                Value="{Binding Value}"
                                                                Detail="{Binding Detail}"
                                                                AccentFill="{Binding AccentFill}"
                                                                AccentGlyph="{Binding AccentGlyph}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="4"
                          Margin="0,-6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Activity heatmap"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Your day in 10-minute blocks"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           FontSize="11" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="toolbar"
                                    Click="TimelineNavButton_Click"
                                    Padding="10,6"
                                    Height="36">
                                <TextBlock Text="See full timeline"
                                           FontSize="11" />
                            </Button>
                        </Grid>
                        <controls:ActivityHeatmapControl x:Name="OverviewHeatmapControl"
                                                         Grid.Row="1"
                                                         Title=""
                                                         Subtitle=""
                                                         Caption="10 minute blocks" />
                    </Grid>

                    <Grid x:Name="OverviewStoryGrid"
                          ColumnDefinitions="1.78*,0.72*"
                          ColumnSpacing="14">
                        <StackPanel x:Name="OverviewStoryLeftColumn"
                                    Grid.Column="0"
                                    VerticalAlignment="Top"
                                    Spacing="12">
                            <Border Classes="overviewPanel"
                                    Padding="18">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Moments today"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Key moments from your day"
                                                       Foreground="{DynamicResource SubtleTextBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Top">
                                            <Button x:Name="OverviewMomentsScrollLeftButton"
                                                    Classes="toolbar"
                                                    Click="OverviewMomentsScrollLeft_Click"
                                                    Width="36"
                                                    Height="36"
                                                    Padding="0">
                                                <TextBlock Text="‹"
                                                           FontSize="18"
                                                           FontWeight="SemiBold" />
                                            </Button>
                                            <Button x:Name="OverviewMomentsScrollRightButton"
                                                    Classes="toolbar"
                                                    Click="OverviewMomentsScrollRight_Click"
                                                    Width="36"
                                                    Height="36"
                                                    Padding="0">
                                                <TextBlock Text="›"
                                                           FontSize="18"
                                                           FontWeight="SemiBold" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="OverviewMomentsRailHost"
                                          ClipToBounds="True"
                                          MinHeight="276">
                                        <ScrollViewer x:Name="OverviewMomentsScrollViewer"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      AllowAutoHide="False"
                                                      PointerPressed="OverviewMomentsScrollViewer_PointerPressed"
                                                      PointerMoved="OverviewMomentsScrollViewer_PointerMoved"
                                                      PointerReleased="OverviewMomentsScrollViewer_PointerReleased">
                                            <ItemsControl x:Name="OverviewMomentsItems"
                                                          HorizontalAlignment="Left">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="16" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="{Binding CardWidth}"
                                                              Margin="0,0,0,0">
                                                            <Button Classes="momentCard"
                                                                    Click="OverviewMomentButton_Click"
                                                                    CommandParameter="{Binding Id}"
                                                                    ToolTip.Tip="Jump to this moment in the timeline">
                                                                <controls:MomentCard Title="{Binding Title}"
                                                                                     Subtitle="{Binding Subtitle}"
                                                                                     Timestamp="{Binding Timestamp}"
                                                                                     Duration="{Binding Duration}"
                                                                                     Category="{Binding Category}"
                                                                                     AccentFill="{Binding AccentFill}"
                                                                                     AccentText="{Binding AccentText}"
                                                                                     Source="{Binding Source}"
                                                                                     PreviewPath="{Binding ThumbnailPath}" />
                                                            </Button>
                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="6"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        Margin="0,10,10,0"
                                                                        Panel.ZIndex="2">
                                                                <Button Classes="toolbar"
                                                                        Click="OverviewOpenMomentButton_Click"
                                                                        CommandParameter="{Binding Id}"
                                                                        Padding="9,5"
                                                                        Height="30"
                                                                        MinWidth="52"
                                                                        ToolTip.Tip="Open the captured app, site, or file">
                                                                    <TextBlock Text="Open"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold" />
                                                                </Button>
                                                                <Button Classes="toolbar"
                                                                        Click="OverviewPinMomentButton_Click"
                                                                        CommandParameter="{Binding Id}"
                                                                        Padding="9,5"
                                                                        Height="30"
                                                                        MinWidth="44"
                                                                        ToolTip.Tip="Pin or unpin this moment">
                                                                    <TextBlock Text="{Binding PinActionLabel}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <Border x:Name="OverviewMomentsEmptyState"
                                                Margin="4,10,4,0"
                                                Padding="22"
                                                CornerRadius="16"
                                                Background="{DynamicResource ElevatedPanelBrush}"
                                                BorderBrush="{DynamicResource FaintBorderBrush}"
                                                BorderThickness="1"
                                                IsVisible="False">
                                            <StackPanel Spacing="6"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="No moments captured yet"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="This rail fills in as MomentTrace records related windows, sites, and documents through the day."
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           MaxWidth="420" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="OverviewMomentsLeftFade"
                                                Width="28"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource CardBrush}"
                                                Opacity="0.72"
                                                IsHitTestVisible="False" />
                                        <Border x:Name="OverviewMomentsRightFade"
                                                Width="42"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource CardBrush}"
                                                Opacity="0.72"
                                                IsHitTestVisible="False" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <controls:FocusRhythmControl x:Name="OverviewFocusRhythmControl"
                                                         VerticalAlignment="Top"
                                                         Margin="0,-2,0,0"
                                                         Title="Focus rhythm"
                                                         Subtitle="Your activity flow throughout the day" />
                        </StackPanel>

                        <StackPanel x:Name="OverviewStoryRightColumn"
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Spacing="14">
                            <controls:CategoryBreakdownControl x:Name="OverviewCategoryBreakdownControl"
                                                               Title="Activity by category" />
                            <Border Classes="overviewPanel">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Top applications"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="By total active time"
                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                   FontSize="11" />
                                    </StackPanel>
                                    <ItemsControl x:Name="OverviewTopApplicationsItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                      ColumnSpacing="10"
                                                      Margin="0,0,0,10">
                                                    <Border Width="22"
                                                            Height="22"
                                                            Background="{Binding AccentBrush}"
                                                            CornerRadius="6"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Glyph}"
                                                                   Foreground="White"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                Spacing="3">
                                                        <TextBlock Text="{Binding AppName}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                        <Border Background="{DynamicResource ElevatedPanelBrush}"
                                                                Height="4"
                                                                CornerRadius="999">
                                                            <Border Width="{Binding BarWidth}"
                                                                    Background="{DynamicResource AccentBrush}"
                                                                    CornerRadius="999"
                                                                    HorizontalAlignment="Left" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Duration}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11"
                                                               VerticalAlignment="Top" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border x:Name="OverviewTopApplicationsEmptyState"
                                            Background="{DynamicResource ElevatedPanelBrush}"
                                            BorderBrush="{DynamicResource FaintBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16"
                                            IsVisible="False">
                                        <TextBlock Text="No applications have been captured for this day yet."
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Panel x:Name="SettingsPageHost"
                   Grid.Row="1"
                   IsVisible="False"
                   Margin="12,8,4,0" />
            </Grid>
        </Grid>
    </Border>
    <Grid x:Name="PreviewModalOverlay"
          IsVisible="False"
          Background="#D908111F"
          PointerPressed="PreviewModalBackdrop_PointerPressed">
        <Border x:Name="PreviewModalSurface"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource FaintBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16"
                Margin="44"
                MaxWidth="1180"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                PointerPressed="PreviewModalSurface_PointerPressed">
            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="PreviewModalTitleText"
                                   Text="Preview"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PreviewModalSubtitleText"
                                   Text="Captured screenshot"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="shellControl"
                            Click="ClosePreviewModalButton_Click"
                            ToolTip.Tip="Close preview"
                            Width="38"
                            Height="38"
                            VerticalAlignment="Top">
                        <TextBlock Text="×"
                                   FontSize="18"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </Button>
                </Grid>
                <Border Grid.Row="1"
                        Background="{DynamicResource PageBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelEdgeStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        ClipToBounds="True"
                        MinHeight="360">
                    <Image x:Name="PreviewModalImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </Border>
                <Grid Grid.Row="2"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <TextBlock x:Name="PreviewModalPathText"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="Esc closes"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>
