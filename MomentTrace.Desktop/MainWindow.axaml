<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MomentTrace.Desktop.Controls"
        mc:Ignorable="d"
        x:Class="MomentTrace.Desktop.MainWindow"
        Title="MomentTrace"
        Icon="avares://MomentTrace.Desktop/Assets/MomentTrace.ico"
	        Width="1360"
	        Height="840"
	        MinWidth="1120"
	        MinHeight="720"
	        TransparencyLevelHint="Blur, Transparent"
	        WindowDecorations="BorderOnly"
	        ExtendClientAreaToDecorationsHint="True"
	        ExtendClientAreaTitleBarHeightHint="0"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#08111F" />
        <SolidColorBrush x:Key="OuterFrameBrush" Color="#1E2D45" />
        <SolidColorBrush x:Key="RailBrush" Color="#0F1A2E" />
        <SolidColorBrush x:Key="PanelBrush" Color="#111C31" />
        <SolidColorBrush x:Key="SubtlePanelBrush" Color="#16233A" />
        <SolidColorBrush x:Key="ElevatedPanelBrush" Color="#10192B" />
        <SolidColorBrush x:Key="CardBrush" Color="#10192B" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#1C2D49" />
        <SolidColorBrush x:Key="PanelEdgeBrush" Color="#233653" />
        <SolidColorBrush x:Key="PanelEdgeStrongBrush" Color="#2C3E5E" />
        <SolidColorBrush x:Key="FaintBorderBrush" Color="#7A8AA655" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#201A38" />
        <SolidColorBrush x:Key="AccentGlowBrush" Color="#477C5CFF" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ChipBrush" Color="#1B2640" />
        <SolidColorBrush x:Key="ToolbarBrush" Color="#172743" />
        <SolidColorBrush x:Key="ToolbarHoverBrush" Color="#1C2D49" />
        <SolidColorBrush x:Key="OverlayBrush" Color="#B708111F" />
        <SolidColorBrush x:Key="PositiveBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="InfoBrush" Color="#0EA5E9" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#6A334A" />
        <SolidColorBrush x:Key="DangerFillBrush" Color="#3D1F2C" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#142038" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Button.momentCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.momentCard /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.momentCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Opacity" Value="0.97" />
        </Style>
        <Style Selector="Button.momentCard:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.momentCard:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.clickBlock">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.clickBlock /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.clickBlock:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="Button.nav:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="Button.toolbar">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FaintBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.toolbar:pointerover">
            <Setter Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="Button.toolbar:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="Button.toolbar:pressed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="Button.topCommand">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="42" />
        </Style>
        <Style Selector="Button.topCommand:pointerover">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.topCommand:pressed">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.topCommand:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.detailPrimary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Button.detailSecondary">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FaintBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Button.detailDanger">
            <Setter Property="Background" Value="{DynamicResource DangerFillBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Border.overviewMetric">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FaintBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.overviewPanel">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FaintBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.infoChip">
            <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FaintBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="ComboBox.filter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="42" />
        </Style>
        <Style Selector="ComboBox.filter:pointerover">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter:pressed">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter:focus">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBox.filter:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBox.searchBox /template/ TextBlock#watermark">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBox.searchBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="TextBox.searchBox:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.searchBox:focus">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.searchBox /template/ Border#border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.searchBox:focus /template/ Border#border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.searchBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.searchBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Margin" Value="8,0,4,0" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10" />
            <Setter Property="MinHeight" Value="10" />
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        </Style>
        <Style Selector="ScrollBar /template/ Button">
            <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ScrollBar:pointerover /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
        </Style>
        <Style Selector="Thumb.ScrollBarThumb">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Thumb.ScrollBarThumb:pointerover">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Thumb.ScrollBarThumb:pressed">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="Fill" Value="{DynamicResource ScrollTrackBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="RepeatButton.ScrollBarPageButton">
            <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
        </Style>
        <Style Selector="TabControl.detailTabs TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TabControl.detailTabs TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource SubtlePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
    </Window.Styles>
    <Border x:Name="OuterShell"
            Margin="0"
            Background="{DynamicResource PageBackgroundBrush}"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="0"
            Padding="24,18,24,18">
    <Grid ColumnDefinitions="284,*">
        <Border x:Name="RailSurface"
                Grid.Column="0"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0"
                Padding="16,16,18,16"
                Margin="0,0,22,0"
                PointerPressed="ToolbarDragRegion_PointerPressed">
            <Grid RowDefinitions="Auto,Auto,Auto,* ,Auto,Auto">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource ToolbarBrush}">
                            <TextBlock Text="MT"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="MomentTrace"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,28,0,0" Spacing="0">
                    <TextBlock Text="Workspace"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               FontSize="12"
                               Margin="6,0,0,10" />
                    <Border x:Name="TimelineNavHighlight"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="7"
                            Margin="0,0,0,6">
                        <Button x:Name="TimelineNavButton"
                                Classes="nav"
                                Click="TimelineNavButton_Click"
                                HorizontalContentAlignment="Left"
                                Foreground="White">
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <TextBlock Text="⌘"
                                           Width="28"
                                           TextAlignment="Center"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Timeline"
                                           Margin="10,0,0,0"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border x:Name="OverviewNavHighlight"
                            Background="Transparent"
                            CornerRadius="7"
                            Margin="0,0,0,6">
                        <Button x:Name="OverviewNavButton"
                                Classes="nav"
                                Click="OverviewNavButton_Click"
                                HorizontalContentAlignment="Left"
                                Foreground="{DynamicResource MutedTextBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <TextBlock Text="◎"
                                           Width="28"
                                           TextAlignment="Center"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Overview"
                                           Margin="10,0,0,0"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2"
                        Height="1"
                        Background="{DynamicResource PanelEdgeBrush}"
                        Margin="0,18,0,18" />

                <ScrollViewer Grid.Row="3"
                              Margin="0,0,0,10"
                              Padding="0,0,34,0"
                              AllowAutoHide="False"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18"
                                Margin="0,0,30,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Activity"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="12"
                                       Margin="2,0,0,4" />
                            <Button x:Name="BrowsingNavButton"
                                    Classes="nav"
                                    Click="BrowsingNavButton_Click"
                                    HorizontalContentAlignment="Left"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock Text="◎" FontSize="12" Width="28" TextAlignment="Center" />
                                    <TextBlock Text="Browsing" Margin="10,0,0,0" FontSize="14" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DevelopmentNavButton"
                                    Classes="nav"
                                    Click="DevelopmentNavButton_Click"
                                    HorizontalContentAlignment="Left"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock Text="&lt;/&gt;" FontSize="11" Width="28" TextAlignment="Center" />
                                    <TextBlock Text="Development" Margin="10,0,0,0" FontSize="14" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CommunicationNavButton"
                                    Classes="nav"
                                    Click="CommunicationNavButton_Click"
                                    HorizontalContentAlignment="Left"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock Text="◌" FontSize="12" Width="28" TextAlignment="Center" />
                                    <TextBlock Text="Communication" Margin="10,0,0,0" FontSize="14" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DocumentsNavButton"
                                    Classes="nav"
                                    Click="DocumentsNavButton_Click"
                                    HorizontalContentAlignment="Left"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock Text="▤" FontSize="12" Width="28" TextAlignment="Center" />
                                    <TextBlock Text="Documents" Margin="10,0,0,0" FontSize="14" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource PanelEdgeBrush}" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="Library"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="12"
                                       Margin="2,0,0,4" />
                            <Button x:Name="SavedMomentsNavButton"
                                    Classes="nav"
                                    Click="SavedMomentsNavButton_Click"
                                    HorizontalContentAlignment="Left"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock Text="★" FontSize="12" Width="28" TextAlignment="Center" />
                                    <TextBlock Text="Saved Moments" Margin="10,0,0,0" FontSize="14" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NotesNavButton"
                                    Classes="nav"
                                    Click="NotesNavButton_Click"
                                    HorizontalContentAlignment="Left"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock Text="☰" FontSize="12" Width="28" TextAlignment="Center" />
                                    <TextBlock Text="Notes" Margin="10,0,0,0" FontSize="14" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BookmarksNavButton"
                                    Classes="nav"
                                    Click="BookmarksNavButton_Click"
                                    HorizontalContentAlignment="Left"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock Text="⌑" FontSize="12" Width="28" TextAlignment="Center" />
                                    <TextBlock Text="Bookmarks" Margin="10,0,0,0" FontSize="14" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource PanelEdgeBrush}" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="Sources"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="12"
                                       Margin="2,0,0,4" />
                            <Button x:Name="AppsNavButton"
                                    Classes="nav"
                                    Click="AppsNavButton_Click"
                                    HorizontalContentAlignment="Left"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock Text="▦" FontSize="12" Width="28" TextAlignment="Center" />
                                    <TextBlock Text="Apps" Margin="10,0,0,0" FontSize="14" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="WebsitesNavButton"
                                    Classes="nav"
                                    Click="WebsitesNavButton_Click"
                                    HorizontalContentAlignment="Left"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock Text="◎" FontSize="12" Width="28" TextAlignment="Center" />
                                    <TextBlock Text="Websites" Margin="10,0,0,0" FontSize="14" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FilesNavButton"
                                    Classes="nav"
                                    Click="FilesNavButton_Click"
                                    HorizontalContentAlignment="Left"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock Text="□" FontSize="12" Width="28" TextAlignment="Center" />
                                    <TextBlock Text="Files" Margin="10,0,0,0" FontSize="14" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="4"
                            Margin="0,0,0,14">
                    <Border Height="1" Background="{DynamicResource PanelEdgeBrush}" Margin="0,0,0,16" />
                    <DockPanel Margin="0,0,0,14">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="34"
                                    Height="34"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="17">
                                <TextBlock Text="B"
                                           Foreground="White"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0">
                                <TextBlock Text="blakb"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="GREENMONKEY\\blakb"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <Button x:Name="SettingsNavButton"
                            Classes="nav"
                            Click="SettingsNavButton_Click"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Foreground="{DynamicResource MutedTextBrush}"
                            BorderBrush="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <TextBlock Text="⚙"
                                       Width="28"
                                       TextAlignment="Center"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Settings"
                                       Margin="10,0,0,0"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="0"
                HorizontalAlignment="Right"
                Width="1"
                Margin="0,8,10,8"
                Background="{DynamicResource PanelEdgeBrush}" />

        <Grid Grid.Column="1" RowDefinitions="76,*"
              Margin="12,0,0,0">
            <Border x:Name="TopCommandSurface"
                    Margin="16,10,18,0"
                    Background="{DynamicResource ToolbarBrush}"
                    BorderBrush="{DynamicResource PanelEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="8"
                    PointerPressed="ToolbarDragRegion_PointerPressed">
                    <Grid ColumnDefinitions="*,142,96,50,50,50,50"
                          ColumnSpacing="12"
                          VerticalAlignment="Center">
                        <Border x:Name="SearchSurface"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource PanelEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="14,8"
                                MinHeight="40">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock x:Name="SearchIconText"
                                           Text="⌕"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           FontSize="20"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="SearchTextBox"
                                         Classes="searchBox"
                                         Grid.Column="1"
                                         TextChanged="SearchTextBox_TextChanged"
                                         GotFocus="SearchTextBox_GotFocus"
                                         LostFocus="SearchTextBox_LostFocus"
                                         PlaceholderText="Search moments, sessions, apps, or websites..."
                                         PlaceholderForeground="{DynamicResource SubtleTextBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextBrush}" />
                            </Grid>
                        </Border>
                        <ComboBox x:Name="DateFilterComboBox"
                                  Classes="filter"
                                  Grid.Column="1"
                                  SelectionChanged="DateFilterComboBox_SelectionChanged"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  MinHeight="40" />
                        <ComboBox x:Name="TypeFilterComboBox"
                                  Classes="filter"
                                  Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  MinHeight="40" />
                        <Button Grid.Column="3"
                                Classes="toolbar topCommand"
                                Click="ToggleDetailsButton_Click"
                                Width="48">
                            <TextBlock Text="☰"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Button>
                        <Button x:Name="MinimizeShellButton"
                                Grid.Column="4"
                                Classes="toolbar topCommand"
                                Click="MinimizeShellButton_Click"
                                Width="48">
                            <TextBlock Text="−"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Button>
                        <Button x:Name="MaximizeShellButton"
                                Grid.Column="5"
                                Classes="toolbar topCommand"
                                Click="MaximizeShellButton_Click"
                                Width="48">
                            <TextBlock Text="□"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Button>
                        <Button x:Name="CloseShellButton"
                                Grid.Column="6"
                                Classes="toolbar topCommand"
                                Click="CloseShellButton_Click"
                                Width="48">
                            <TextBlock Text="×"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Button>
                    </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid x:Name="TimelinePage" Margin="16,20,22,0">
                    <Grid x:Name="TimelineContentGrid"
                          ColumnDefinitions="*,380"
                          ClipToBounds="True">
                    <Grid Grid.Column="0"
                          Margin="0,0,14,0"
                          MinWidth="0"
                          ClipToBounds="True"
                          RowDefinitions="Auto,*">
                            <StackPanel Margin="0,0,0,20"
                                        Spacing="0">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                    <TextBlock Text="Timeline"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                    <Border Classes="infoChip"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TimelineCountText"
                                                   Text="Moments"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="13"
                                                   Margin="0,2,0,0" />
                                    </Border>
                                    <Border Classes="infoChip"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Stored locally · Only visible to you"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TimelineSubtitleText"
                                           Text="Grouped into local moments and arranged along a shared activity rail."
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           FontSize="13"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ScrollViewer x:Name="TimelineScrollViewer"
                                          Grid.Row="1"
                                          AllowAutoHide="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          ClipToBounds="True">
                                <ItemsControl x:Name="TimelineGroupsItems"
                                              Margin="0,0,12,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="36,*" Margin="0,0,0,24">
                                                <Grid>
                                                    <Border Width="2"
                                                            Background="{DynamicResource PanelEdgeBrush}"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,28,0,0" />
                                                    <Border Width="16"
                                                            Height="16"
                                                            CornerRadius="8"
                                                            Background="{Binding AccentBrush}"
                                                            BorderBrush="{DynamicResource PanelBrush}"
                                                            BorderThickness="2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Top"
                                                            Margin="0,12,0,0" />
                                                </Grid>
                                                    <StackPanel Grid.Column="1" Spacing="16">
                                                    <Grid ColumnDefinitions="104,*" ColumnSpacing="12">
                                                        <Border Background="{Binding AccentBrush}"
                                                                CornerRadius="12"
                                                                Padding="9,3"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding TimeRange}"
                                                                       Foreground="White"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding Name}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontSize="15"
                                                                           FontWeight="SemiBold" />
                                                                <Border Classes="infoChip"
                                                                        Margin="10,-1,0,0"
                                                                        VerticalAlignment="Top">
                                                                    <TextBlock Text="{Binding CountLabel}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold" />
                                                                </Border>
                                                             </StackPanel>
                                                             <TextBlock Text="{Binding Summary}"
                                                                        Foreground="{DynamicResource MutedTextBrush}"
                                                                        Margin="0,7,0,0"
                                                                        FontSize="12"
                                                                        TextWrapping="Wrap" />
                                                         </StackPanel>
                                                     </Grid>
                                                    <ItemsControl ItemsSource="{Binding Moments}"
                                                                  IsVisible="{Binding ShowCards}"
                                                                  Margin="0,2,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Click="TimelineMomentButton_Click"
                                                                        Classes="momentCard"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="0"
                                                                        Margin="0,0,12,12"
                                                                        HorizontalAlignment="Stretch">
                                                                        <Border Width="218"
                                                                                Height="150"
                                                                                Background="{Binding CardBackground}"
                                                                                BorderBrush="{Binding BorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="8"
                                                                                Padding="0">
                                                                            <Grid RowDefinitions="82,*">
                                                                                <Border Background="{DynamicResource ElevatedPanelBrush}"
                                                                                        CornerRadius="8"
                                                                                        Padding="0"
                                                                                        ClipToBounds="True">
                                                                                    <Grid>
                                                                                        <Image Source="{Binding PreviewImage}"
                                                                                               Stretch="UniformToFill"
                                                                                               IsVisible="{Binding ShowPreviewImage}" />
                                                                                        <Border Background="{DynamicResource ElevatedPanelBrush}"
                                                                                                IsVisible="{Binding ShowHeroIcon}">
                                                                                            <Image Source="{Binding IconImage}"
                                                                                                   Width="58"
                                                                                                   Height="58"
                                                                                                   Stretch="Uniform"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center" />
                                                                                        </Border>
                                                                                        <Border Background="{DynamicResource ElevatedPanelBrush}"
                                                                                                IsVisible="{Binding ShowGlyphFallback}" />
                                                                                        <Border HorizontalAlignment="Right"
                                                                                                Background="{DynamicResource SubtlePanelBrush}"
                                                                                                CornerRadius="5"
                                                                                                Padding="6,2"
                                                                                                Margin="0,8,8,0"
                                                                                                VerticalAlignment="Top">
                                                                                            <TextBlock Text="{Binding TimeLabel}"
                                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                                       FontSize="11"
                                                                                                       FontWeight="SemiBold" />
                                                                                        </Border>
                                                                                        <Border Width="60"
                                                                                                Height="60"
                                                                                                CornerRadius="16"
                                                                                                Background="{Binding GlyphBackground}"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                IsVisible="{Binding ShowGlyphFallback}">
                                                                                            <TextBlock Text="{Binding Glyph}"
                                                                                                       Foreground="{Binding GlyphForeground}"
                                                                                                       FontSize="20"
                                                                                                       FontWeight="Bold"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       VerticalAlignment="Center" />
                                                                                        </Border>
                                                                                        <Border HorizontalAlignment="Right"
                                                                                                VerticalAlignment="Bottom"
                                                                                                Margin="0,0,8,8"
                                                                                                Background="{DynamicResource SubtlePanelBrush}"
                                                                                                CornerRadius="5"
                                                                                                Padding="6,2">
                                                                                            <TextBlock Text="{Binding SeenLabel}"
                                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                                       FontSize="11"
                                                                                                       FontWeight="SemiBold" />
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </Border>
                                                                                <Grid Grid.Row="1"
                                                                                      Margin="10,8,10,8"
                                                                                      RowDefinitions="Auto,Auto">
                                                                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                                                                          ColumnSpacing="7">
                                                                                        <Border Width="18"
                                                                                                Height="18"
                                                                                                CornerRadius="0"
                                                                                                Background="Transparent"
                                                                                                VerticalAlignment="Top">
                                                                                            <Grid>
                                                                                                <Image Source="{Binding IconImage}"
                                                                                                       Width="16"
                                                                                                       Height="16"
                                                                                                       Stretch="Uniform"
                                                                                                       IsVisible="{Binding ShowSmallIcon}"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       VerticalAlignment="Center" />
                                                                                                <TextBlock Text="{Binding Glyph}"
                                                                                                           Foreground="{Binding GlyphForeground}"
                                                                                                           FontSize="10"
                                                                                                           FontWeight="SemiBold"
                                                                                                           IsVisible="{Binding ShowSmallGlyph}"
                                                                                                           HorizontalAlignment="Center"
                                                                                                           VerticalAlignment="Center" />
                                                                                            </Grid>
                                                                                        </Border>
                                                                                        <TextBlock Grid.Column="1"
                                                                                                   Text="{Binding Title}"
                                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                                   FontWeight="SemiBold"
                                                                                                   TextWrapping="Wrap"
                                                                                                   FontSize="13"
                                                                                                   MaxWidth="154"
                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Grid.Column="2"
                                                                                                   Text="⋮"
                                                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                                                   FontSize="16"
                                                                                                   VerticalAlignment="Top" />
                                                                                    </Grid>
                                                                                    <TextBlock Grid.Row="1"
                                                                                               Text="{Binding Subtitle}"
                                                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                                                               Margin="25,2,0,0"
                                                                                               FontSize="12"
                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                </Grid>
                                                                            </Grid>
                                                                        </Border>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding Moments}"
                                                                  IsVisible="{Binding ShowList}"
                                                                  Margin="0,0,12,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Click="TimelineMomentButton_Click"
                                                                        Classes="momentCard"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="0"
                                                                        Margin="0,0,0,10"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Stretch">
                                                                    <Border MinHeight="78"
                                                                            Background="{Binding CardBackground}"
                                                                            BorderBrush="{Binding BorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="9"
                                                                            Padding="10">
                                                                        <Grid ColumnDefinitions="64,*,Auto"
                                                                              ColumnSpacing="12">
                                                                            <Border Width="56"
                                                                                    Height="56"
                                                                                    Background="{DynamicResource ElevatedPanelBrush}"
                                                                                    CornerRadius="8"
                                                                                    ClipToBounds="True"
                                                                                    VerticalAlignment="Center">
                                                                                <Grid>
                                                                                    <Image Source="{Binding PreviewImage}"
                                                                                           Stretch="UniformToFill"
                                                                                           IsVisible="{Binding ShowPreviewImage}" />
                                                                                    <Image Source="{Binding IconImage}"
                                                                                           Width="36"
                                                                                           Height="36"
                                                                                           Stretch="Uniform"
                                                                                           IsVisible="{Binding ShowHeroIcon}"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center" />
                                                                                    <Border Width="36"
                                                                                            Height="36"
                                                                                            CornerRadius="10"
                                                                                            Background="{Binding GlyphBackground}"
                                                                                            IsVisible="{Binding ShowGlyphFallback}"
                                                                                            HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding Glyph}"
                                                                                                   Foreground="{Binding GlyphForeground}"
                                                                                                   FontSize="14"
                                                                                                   FontWeight="Bold"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center" />
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Border>
                                                                            <StackPanel Grid.Column="1"
                                                                                        VerticalAlignment="Center">
                                                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                                                      ColumnSpacing="8">
                                                                                    <Image Source="{Binding IconImage}"
                                                                                           Width="16"
                                                                                           Height="16"
                                                                                           Stretch="Uniform"
                                                                                           IsVisible="{Binding ShowSmallIcon}"
                                                                                           VerticalAlignment="Center" />
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding Title}"
                                                                                               Foreground="{DynamicResource TextBrush}"
                                                                                               FontWeight="SemiBold"
                                                                                               FontSize="13"
                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                    <Border Grid.Column="2"
                                                                                            Background="{Binding KindBackground}"
                                                                                            CornerRadius="8"
                                                                                            Padding="8,2"
                                                                                            VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding KindLabel}"
                                                                                                   Foreground="{Binding KindForeground}"
                                                                                                   FontSize="10"
                                                                                                   FontWeight="SemiBold" />
                                                                                    </Border>
                                                                                </Grid>
                                                                                <TextBlock Text="{Binding Subtitle}"
                                                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                                                           Margin="0,5,0,0"
                                                                                           FontSize="12"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Text="{Binding Meta}"
                                                                                           Foreground="{DynamicResource SubtleTextBrush}"
                                                                                           Margin="0,4,0,0"
                                                                                           FontSize="11"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="2"
                                                                                        VerticalAlignment="Center"
                                                                                        HorizontalAlignment="Right">
                                                                                <TextBlock Text="{Binding TimeLabel}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontSize="12"
                                                                                           FontWeight="SemiBold"
                                                                                           HorizontalAlignment="Right" />
                                                                                <Border Background="{DynamicResource ToolbarBrush}"
                                                                                        CornerRadius="6"
                                                                                        Padding="7,2"
                                                                                        Margin="0,7,0,0">
                                                                                    <TextBlock Text="{Binding SeenLabel}"
                                                                                               Foreground="{DynamicResource TextBrush}"
                                                                                               FontSize="11"
                                                                                               FontWeight="SemiBold" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button IsVisible="{Binding HasExpandablePreview}"
                                                            Click="TimelineGroupToggleButton_Click"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            HorizontalAlignment="Left"
                                                            Padding="0"
                                                            Margin="0,2,0,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding ToggleText}"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ToggleGlyph}"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Border x:Name="TimelineEmptyState"
                                    Grid.Row="1"
                                    IsVisible="False"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource FaintBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="22"
                                    Margin="0,6,12,0"
                                    VerticalAlignment="Top">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="TimelineEmptyTitleText"
                                               Text="No moments yet"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="TimelineEmptyDetailText"
                                               Text="Captured activity will appear here once local moments are available."
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               LineHeight="19" />
                                    <Button x:Name="TimelineEmptyActionButton"
                                            Classes="toolbar"
                                            Click="TimelineEmptyActionButton_Click"
                                            IsVisible="False"
                                            HorizontalAlignment="Left"
                                            Margin="0,6,0,0"
                                            Padding="12,7">
                                        <TextBlock x:Name="TimelineEmptyActionButtonText"
                                                   Text="Show all activity"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                    <Border x:Name="DetailSurface"
                            Grid.Column="1"
                            Width="380"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource PanelEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="24,30,22,24"
                            PointerPressed="ToolbarDragRegion_PointerPressed">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Grid ColumnDefinitions="62,*" ColumnSpacing="0">
                                <Border x:Name="DetailGlyphHost"
                                        Width="62"
                                        Height="62"
                                        CornerRadius="9"
                                        Background="{DynamicResource SubtlePanelBrush}">
                                    <Grid>
                                        <Image x:Name="DetailIconImage"
                                               Width="44"
                                               Height="44"
                                               Stretch="Uniform"
                                               IsVisible="False"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                        <TextBlock x:Name="DetailGlyphText"
                                                   Text="MT"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="14,5,0,0"
                                            Spacing="6">
                                    <TextBlock x:Name="DetailTitleText"
                                               Text="Select a moment"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="DetailSubtitleText"
                                               Text="Timeline context appears here"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        Margin="0,24,0,18">
                                <Button x:Name="OpenMomentButton"
                                        Classes="detailPrimary"
                                        Click="OpenMomentButton_Click">
                                    <TextBlock Text="↗ Open"
                                               FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="PinMomentButton"
                                        Classes="detailSecondary"
                                        Click="PinMomentButton_Click">
                                    <TextBlock x:Name="PinMomentButtonText"
                                               Text="Pin"
                                               FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="BookmarkMomentButton"
                                        Classes="detailSecondary"
                                        Click="BookmarkMomentButton_Click">
                                    <TextBlock x:Name="BookmarkMomentButtonText"
                                               Text="Bookmark"
                                               FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="DeleteMomentButton"
                                        Classes="detailDanger"
                                        Click="DeleteMomentButton_Click"
                                        Width="42"
                                        Height="42"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center">
                                    <Grid Width="42" Height="42">
                                        <TextBlock Text=""
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,0,0,0">
                                <Grid RowDefinitions="35,1" Margin="0,0,0,16">
                                    <Grid ColumnDefinitions="*,*,*">
                                        <Button x:Name="OverviewDetailTabButton"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="DetailTabButton_Click"
                                                CommandParameter="Overview"
                                                Padding="0">
                                            <Grid RowDefinitions="*,3">
                                                <TextBlock x:Name="OverviewDetailTabText"
                                                           Text="Overview"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Border x:Name="OverviewDetailTabUnderline"
                                                        Grid.Row="1"
                                                        Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="2"
                                                        Margin="12,0" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="ActivityDetailTabButton"
                                                Grid.Column="1"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="DetailTabButton_Click"
                                                CommandParameter="Activity"
                                                Padding="0">
                                            <Grid RowDefinitions="*,3">
                                                <TextBlock x:Name="ActivityDetailTabText"
                                                           Text="Activity"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Border x:Name="ActivityDetailTabUnderline"
                                                        Grid.Row="1"
                                                        Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="2"
                                                        Margin="12,0"
                                                        IsVisible="False" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="RelatedDetailTabButton"
                                                Grid.Column="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="DetailTabButton_Click"
                                                CommandParameter="Related"
                                                Padding="0">
                                            <Grid RowDefinitions="*,3">
                                                <TextBlock x:Name="RelatedDetailTabText"
                                                           Text="Related"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Border x:Name="RelatedDetailTabUnderline"
                                                        Grid.Row="1"
                                                        Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="2"
                                                        Margin="12,0"
                                                        IsVisible="False" />
                                            </Grid>
                                        </Button>
                                    </Grid>
                                    <Border Grid.Row="1"
                                            Background="{DynamicResource PanelEdgeBrush}"
                                            Opacity="0.9" />
                                </Grid>

                                <ScrollViewer x:Name="OverviewDetailTabContent"
                                              Grid.Row="1"
                                              AllowAutoHide="False"
                                              Margin="0,0,0,0"
                                              VerticalScrollBarVisibility="Visible"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,12,0">
                                        <StackPanel Margin="0,0,0,18">
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Click="DetailSectionToggleButton_Click"
                                                    CommandParameter="OverviewNarrative">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <TextBlock x:Name="OverviewNarrativeHeaderText"
                                                               Text="Moment overview"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="OverviewNarrativeToggleText"
                                                               Grid.Column="1"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="OverviewNarrativeToggleGlyph"
                                                               Grid.Column="2"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <Border x:Name="OverviewNarrativeSection"
                                                    Background="{DynamicResource SubtlePanelBrush}"
                                                    BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="16"
                                                    Margin="0,10,0,0">
                                                <TextBlock x:Name="DetailNarrativeText"
                                                           Text="Select a moment to inspect its grouped raw activity and nearby related work."
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="13"
                                                           LineHeight="19"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,18">
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Click="DetailSectionToggleButton_Click"
                                                    CommandParameter="Preview">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <TextBlock x:Name="PreviewHeaderText"
                                                               Text="Preview"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="PreviewToggleText"
                                                               Grid.Column="1"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="PreviewToggleGlyph"
                                                               Grid.Column="2"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <Border x:Name="DetailPreviewSection"
                                                    Margin="0,10,0,0">
                                                <Border x:Name="DetailPreviewHost"
                                                        Background="{DynamicResource PanelBrush}"
                                                        BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        ClipToBounds="True"
                                                        Height="150"
                                                        IsVisible="False">
                                                    <Image x:Name="DetailPreviewImage"
                                                           Stretch="UniformToFill" />
                                                </Border>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,18">
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Click="DetailSectionToggleButton_Click"
                                                    CommandParameter="Metadata">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <TextBlock x:Name="MetadataHeaderText"
                                                               Text="Moment details"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="MetadataToggleText"
                                                               Grid.Column="1"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="MetadataToggleGlyph"
                                                               Grid.Column="2"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <Border x:Name="MetadataSection"
                                                    Background="{DynamicResource SubtlePanelBrush}"
                                                    BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16"
                                                    Margin="0,10,0,0">
                                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                                          ColumnDefinitions="Auto,*"
                                                          RowSpacing="10"
                                                          ColumnSpacing="14">
                                                        <TextBlock Text="Visible span"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Margin="0,0,0,12" />
                                                        <TextBlock Grid.Column="1"
                                                                   x:Name="DetailMetaSpanText"
                                                                   Text="Local only"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   Margin="0,0,0,12" />
                                                        <TextBlock Grid.Row="1"
                                                                   Text="From"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Margin="0,0,0,12" />
                                                        <TextBlock Grid.Row="1"
                                                                   Grid.Column="1"
                                                                   x:Name="DetailMetaStartedText"
                                                                   Text="Local only"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   Margin="0,0,0,12"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="2"
                                                                   Text="Until"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Margin="0,0,0,12" />
                                                        <TextBlock Grid.Row="2"
                                                                   Grid.Column="1"
                                                                   x:Name="DetailMetaEndedText"
                                                                   Text="Local only"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   Margin="0,0,0,12"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="3"
                                                                   Text="Source"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Margin="0,0,0,12" />
                                                        <TextBlock Grid.Row="3"
                                                                   Grid.Column="1"
                                                                   x:Name="DetailMetaSourceText"
                                                                   Text="MomentTrace"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   Margin="0,0,0,12"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="4"
                                                                   Text="Category"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Margin="0,0,0,12" />
                                                        <Border Grid.Row="4"
                                                                Grid.Column="1"
                                                                Background="{DynamicResource AccentBrush}"
                                                                CornerRadius="4"
                                                                HorizontalAlignment="Left"
                                                                Padding="7,2"
                                                                Margin="0,0,0,12">
                                                            <TextBlock x:Name="DetailMetaCategoryText"
                                                                       Text="Moment"
                                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock Grid.Row="5"
                                                                   Text="Privacy"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Grid.Row="5"
                                                                   Grid.Column="1"
                                                                   Text="Stored locally"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                    </Grid>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,18">
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Click="DetailSectionToggleButton_Click"
                                                    CommandParameter="Note">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <TextBlock x:Name="NoteHeaderText"
                                                               Text="Personal note"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="NoteToggleText"
                                                               Grid.Column="1"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="NoteToggleGlyph"
                                                               Grid.Column="2"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <Border x:Name="NoteSection"
                                                    Background="{DynamicResource ElevatedPanelBrush}"
                                                    BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16"
                                                    Margin="0,10,0,0">
                                                <StackPanel>
                                                    <Button Classes="detailSecondary"
                                                            Click="SaveNoteButton_Click"
                                                            Padding="10,6"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,0,0,10">
                                                        <TextBlock Text="Save note"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Button>
                                                    <TextBox x:Name="MomentNoteTextBox"
                                                             Background="{DynamicResource PanelBrush}"
                                                             BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                             BorderThickness="1"
                                                             Foreground="{DynamicResource TextBrush}"
                                                             MinHeight="78"
                                                             Padding="12"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel>
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Click="DetailSectionToggleButton_Click"
                                                    CommandParameter="RecentActivity">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <TextBlock x:Name="RecentActivityHeaderText"
                                                               Text="Recent activity"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="RecentActivityToggleText"
                                                               Grid.Column="1"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="RecentActivityToggleGlyph"
                                                               Grid.Column="2"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <Border x:Name="RecentActivitySection"
                                                    Background="{DynamicResource SubtlePanelBrush}"
                                                    BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16"
                                                    Margin="0,10,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Recorded by MomentTrace"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="13"
                                                               Margin="0,0,0,10" />
                                                    <TextBlock Text="Recording foreground window activity with timestamps."
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="13"
                                                               LineHeight="19"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer x:Name="ActivityDetailTabContent"
                                              Grid.Row="1"
                                              Margin="0,14,0,0"
                                              IsVisible="False"
                                              AllowAutoHide="False"
                                              VerticalScrollBarVisibility="Visible"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,12,0">
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="DetailSectionToggleButton_Click"
                                                CommandParameter="CapturedActivity">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <TextBlock x:Name="CapturedActivityHeaderText"
                                                           Text="Captured activity"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock x:Name="CapturedActivityToggleText"
                                                           Grid.Column="1"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:Name="CapturedActivityToggleGlyph"
                                                           Grid.Column="2"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <Border x:Name="CapturedActivitySection"
                                                Background="{DynamicResource PanelBrush}"
                                                BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12"
                                                Margin="0,10,0,0">
                                            <StackPanel Spacing="8">
                                                <TextBlock x:Name="ActivityTabSummaryText"
                                                           Text="Select a moment to inspect its raw captured entries."
                                                           Foreground="{DynamicResource SubtleTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <ItemsControl x:Name="RawEntriesItems">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtlePanelBrush}"
                                                                    BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Padding="10"
                                                                    Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Source}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding TimeRange}" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,6,0,0" FontSize="11" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer x:Name="RelatedDetailTabContent"
                                              Grid.Row="1"
                                              Margin="0,14,0,0"
                                              IsVisible="False"
                                              AllowAutoHide="False"
                                              VerticalScrollBarVisibility="Visible"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,12,0">
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="DetailSectionToggleButton_Click"
                                                CommandParameter="RelatedMoments">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <TextBlock x:Name="RelatedMomentsHeaderText"
                                                           Text="Related moments"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock x:Name="RelatedMomentsToggleText"
                                                           Grid.Column="1"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:Name="RelatedMomentsToggleGlyph"
                                                           Grid.Column="2"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <Border x:Name="RelatedMomentsSection"
                                                Background="{DynamicResource PanelBrush}"
                                                BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12"
                                                Margin="0,10,0,0">
                                            <StackPanel Spacing="8">
                                                <TextBlock x:Name="RelatedSummaryText"
                                                           Text="No related moments yet"
                                                           Foreground="{DynamicResource SubtleTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <ItemsControl x:Name="RelatedMomentsItems">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtlePanelBrush}"
                                                                    BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Padding="10"
                                                                    Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                </Grid>

            <ScrollViewer x:Name="OverviewPage" Grid.Row="1" IsVisible="False" AllowAutoHide="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14"
                            Margin="0,0,12,0">
                    <StackPanel Spacing="2"
                                Margin="2,6,0,0">
                        <TextBlock x:Name="OverviewDateText"
                                   Text="Today"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="26"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="At a glance"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   FontSize="12" />
                        <TextBlock x:Name="OverviewLeadText"
                                   Text="A visual summary of the day"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12" />
                    </StackPanel>

                    <Border x:Name="OverviewTimelineContextBanner"
                            IsVisible="False"
                            Background="{DynamicResource ElevatedPanelBrush}"
                            BorderBrush="{DynamicResource FaintBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="10">
                            <TextBlock x:Name="OverviewTimelineContextText"
                                       Text="Timeline is currently focused to a subset of the day."
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button x:Name="OverviewTimelineContextResumeButton"
                                    Grid.Column="1"
                                    Classes="toolbar"
                                    Click="OverviewTimelineContextResumeButton_Click"
                                    Padding="10,6"
                                    MinWidth="110">
                                <TextBlock Text="Resume timeline"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Button>
                            <Button x:Name="OverviewTimelineContextClearButton"
                                    Grid.Column="2"
                                    Classes="toolbar"
                                    Click="OverviewTimelineContextClearButton_Click"
                                    Padding="10,6"
                                    MinWidth="92">
                                <TextBlock Text="Clear"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Button>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="OverviewSummaryItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent"
                                        BorderThickness="0"
                                        Margin="0,0,12,12">
                                    <controls:SummaryMetricCard Label="{Binding Label}"
                                                                Value="{Binding Value}"
                                                                Detail="{Binding Detail}"
                                                                AccentFill="{Binding AccentFill}"
                                                                AccentGlyph="{Binding AccentGlyph}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="4"
                          Margin="0,-6,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Activity heatmap"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Your day in 15-minute blocks"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           FontSize="11" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="toolbar"
                                    Click="TimelineNavButton_Click"
                                    Padding="10,6"
                                    Height="36">
                                <TextBlock Text="See full timeline"
                                           FontSize="11" />
                            </Button>
                        </Grid>
                        <controls:ActivityHeatmapControl x:Name="OverviewHeatmapControl"
                                                         Grid.Row="1"
                                                         Title=""
                                                         Subtitle=""
                                                         Caption="15 minute blocks" />
                    </Grid>

                    <Grid ColumnDefinitions="1.78*,0.72*"
                          ColumnSpacing="14">
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Top"
                                    Spacing="12">
                            <Border Classes="overviewPanel"
                                    Padding="18">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Moments today"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Key moments from your day"
                                                       Foreground="{DynamicResource SubtleTextBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Top">
                                            <Button x:Name="OverviewMomentsScrollLeftButton"
                                                    Classes="toolbar"
                                                    Click="OverviewMomentsScrollLeft_Click"
                                                    Width="36"
                                                    Height="36"
                                                    Padding="0">
                                                <TextBlock Text="‹"
                                                           FontSize="18"
                                                           FontWeight="SemiBold" />
                                            </Button>
                                            <Button x:Name="OverviewMomentsScrollRightButton"
                                                    Classes="toolbar"
                                                    Click="OverviewMomentsScrollRight_Click"
                                                    Width="36"
                                                    Height="36"
                                                    Padding="0">
                                                <TextBlock Text="›"
                                                           FontSize="18"
                                                           FontWeight="SemiBold" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="OverviewMomentsRailHost"
                                          ClipToBounds="True"
                                          MinHeight="276">
                                        <ScrollViewer x:Name="OverviewMomentsScrollViewer"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      AllowAutoHide="False"
                                                      PointerPressed="OverviewMomentsScrollViewer_PointerPressed"
                                                      PointerMoved="OverviewMomentsScrollViewer_PointerMoved"
                                                      PointerReleased="OverviewMomentsScrollViewer_PointerReleased">
                                            <ItemsControl x:Name="OverviewMomentsItems"
                                                          HorizontalAlignment="Left">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="16" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="{Binding CardWidth}"
                                                                Margin="0,0,0,0">
                                                            <Button Classes="momentCard"
                                                                    Click="OverviewMomentButton_Click"
                                                                    CommandParameter="{Binding Id}"
                                                                    ToolTip.Tip="Open this moment in the timeline">
                                                                <controls:MomentCard Title="{Binding Title}"
                                                                                     Subtitle="{Binding Subtitle}"
                                                                                     Timestamp="{Binding Timestamp}"
                                                                                     Duration="{Binding Duration}"
                                                                                     Category="{Binding Category}"
                                                                                     AccentFill="{Binding AccentFill}"
                                                                                     AccentText="{Binding AccentText}"
                                                                                     Source="{Binding Source}"
                                                                                     PreviewPath="{Binding ThumbnailPath}" />
                                                            </Button>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <Border x:Name="OverviewMomentsEmptyState"
                                                Margin="4,10,4,0"
                                                Padding="22"
                                                CornerRadius="16"
                                                Background="{DynamicResource ElevatedPanelBrush}"
                                                BorderBrush="{DynamicResource FaintBorderBrush}"
                                                BorderThickness="1"
                                                IsVisible="False">
                                            <StackPanel Spacing="6"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="No moments captured yet"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="This rail fills in as MomentTrace records related windows, sites, and documents through the day."
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           MaxWidth="420" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="OverviewMomentsLeftFade"
                                                Width="28"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource CardBrush}"
                                                Opacity="0.72"
                                                IsHitTestVisible="False" />
                                        <Border x:Name="OverviewMomentsRightFade"
                                                Width="42"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource CardBrush}"
                                                Opacity="0.72"
                                                IsHitTestVisible="False" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <controls:FocusRhythmControl x:Name="OverviewFocusRhythmControl"
                                                         VerticalAlignment="Top"
                                                         Margin="0,-2,0,0"
                                                         Title="Focus rhythm"
                                                         Subtitle="Your activity flow throughout the day" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Spacing="14">
                            <controls:CategoryBreakdownControl x:Name="OverviewCategoryBreakdownControl"
                                                               Title="Activity by category" />
                            <Border Classes="overviewPanel">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Top applications"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="By total active time"
                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                   FontSize="11" />
                                    </StackPanel>
                                    <ItemsControl x:Name="OverviewTopApplicationsItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                      ColumnSpacing="10"
                                                      Margin="0,0,0,10">
                                                    <Border Width="22"
                                                            Height="22"
                                                            Background="{Binding AccentBrush}"
                                                            CornerRadius="6"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Glyph}"
                                                                   Foreground="White"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                Spacing="3">
                                                        <TextBlock Text="{Binding AppName}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                        <Border Background="{DynamicResource ElevatedPanelBrush}"
                                                                Height="4"
                                                                CornerRadius="999">
                                                            <Border Width="{Binding BarWidth}"
                                                                    Background="{DynamicResource AccentBrush}"
                                                                    CornerRadius="999"
                                                                    HorizontalAlignment="Left" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Duration}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11"
                                                               VerticalAlignment="Top" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border x:Name="OverviewTopApplicationsEmptyState"
                                            Background="{DynamicResource ElevatedPanelBrush}"
                                            BorderBrush="{DynamicResource FaintBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16"
                                            IsVisible="False">
                                        <TextBlock Text="No applications have been captured for this day yet."
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
