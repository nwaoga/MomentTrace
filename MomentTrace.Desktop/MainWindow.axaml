<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MomentTrace.Desktop.MainWindow"
        Title="MomentTrace"
        Width="1360"
        Height="840"
        MinWidth="1120"
        MinHeight="720"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Background="{DynamicResource PageBackgroundBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#08111F" />
        <SolidColorBrush x:Key="OuterFrameBrush" Color="#1E2D45" />
        <SolidColorBrush x:Key="RailBrush" Color="#0F1A2E" />
        <SolidColorBrush x:Key="PanelBrush" Color="#111C31" />
        <SolidColorBrush x:Key="SubtlePanelBrush" Color="#16233A" />
        <SolidColorBrush x:Key="ElevatedPanelBrush" Color="#10192B" />
        <SolidColorBrush x:Key="PanelEdgeBrush" Color="#233653" />
        <SolidColorBrush x:Key="PanelEdgeStrongBrush" Color="#2C3E5E" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#201A38" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ChipBrush" Color="#1B2640" />
        <SolidColorBrush x:Key="ToolbarBrush" Color="#172743" />
        <SolidColorBrush x:Key="ToolbarHoverBrush" Color="#1C2D49" />
        <SolidColorBrush x:Key="PositiveBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="InfoBrush" Color="#0EA5E9" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#304563" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#476285" />
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#142038" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Button.momentCard:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.97" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtlePanelBrush}" />
        </Style>
        <Style Selector="Button.toolbar">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.toolbar:pointerover">
            <Setter Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.detailPrimary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Button.detailSecondary">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Button.detailDanger">
            <Setter Property="Background" Value="#3D1F2C" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#6A334A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Border.overviewMetric">
            <Setter Property="Background" Value="{DynamicResource RailBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.overviewPanel">
            <Setter Property="Background" Value="{DynamicResource RailBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.infoChip">
            <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="ComboBox.filter">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style Selector="TextBox.searchBox /template/ TextBlock#watermark">
            <Setter Property="Foreground" Value="#8D9BB1" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
        </Style>
        <Style Selector="Thumb">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="Thumb:pointerover">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
        </Style>
        <Style Selector="TabControl.detailTabs TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TabControl.detailTabs TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource SubtlePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
    </Window.Styles>
    <Border x:Name="OuterShell"
            Margin="0"
            Background="{DynamicResource PageBackgroundBrush}"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="0"
            Padding="24,18,24,18"
            PointerPressed="ToolbarDragRegion_PointerPressed">
    <Grid ColumnDefinitions="220,*">
        <Border Grid.Column="0"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0"
                Padding="16,16,18,16"
                Margin="0,0,22,0">
            <Grid RowDefinitions="Auto,Auto,Auto,* ,Auto,Auto">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="34" Height="34" CornerRadius="9" Background="#172743">
                            <TextBlock Text="MT"
                                       Foreground="#A78BFA"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="MomentTrace"
                                   Foreground="#F8FAFC"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,28,0,0" Spacing="0">
                    <TextBlock Text="Workspace"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="6,0,0,10" />
                    <Border x:Name="TimelineNavHighlight"
                            Background="#2C2154"
                            CornerRadius="7"
                            Margin="0,0,0,6">
                        <Button x:Name="TimelineNavButton"
                                Classes="nav"
                                Click="TimelineNavButton_Click"
                                HorizontalContentAlignment="Left"
                                Foreground="White">
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <TextBlock Text="⌘"
                                           Width="28"
                                           TextAlignment="Center"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Timeline"
                                           Margin="10,0,0,0"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border x:Name="OverviewNavHighlight"
                            Background="Transparent"
                            CornerRadius="7"
                            Margin="0,0,0,6">
                        <Button x:Name="OverviewNavButton"
                                Classes="nav"
                                Click="OverviewNavButton_Click"
                                HorizontalContentAlignment="Left"
                                Foreground="#CBD5E1">
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <TextBlock Text="◎"
                                           Width="28"
                                           TextAlignment="Center"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Overview"
                                           Margin="10,0,0,0"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2"
                        Height="1"
                        Background="#233653"
                        Margin="0,18,0,18" />

                <ScrollViewer Grid.Row="3"
                              Margin="0,0,0,10"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Activity"
                                       Foreground="#64748B"
                                       FontSize="12"
                                       Margin="2,0,0,4" />
                            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,0,6">
                                <TextBlock Text="◎" Foreground="#E2E8F0" FontSize="12" Width="28" TextAlignment="Center" />
                                <TextBlock Text="Browsing" Margin="10,0,0,0" Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,0,6">
                                <TextBlock Text="&lt;/&gt;" Foreground="#94A3B8" FontSize="11" Width="28" TextAlignment="Center" />
                                <TextBlock Text="Development" Margin="10,0,0,0" Foreground="#94A3B8" FontSize="14" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,0,6">
                                <TextBlock Text="◌" Foreground="#94A3B8" FontSize="12" Width="28" TextAlignment="Center" />
                                <TextBlock Text="Communication" Margin="10,0,0,0" Foreground="#94A3B8" FontSize="14" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,0,6">
                                <TextBlock Text="▤" Foreground="#94A3B8" FontSize="12" Width="28" TextAlignment="Center" />
                                <TextBlock Text="Documents" Margin="10,0,0,0" Foreground="#94A3B8" FontSize="14" />
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="#233653" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="Library"
                                       Foreground="#64748B"
                                       FontSize="12"
                                       Margin="2,0,0,4" />
                            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,0,6">
                                <TextBlock Text="★" Foreground="#E2E8F0" FontSize="12" Width="28" TextAlignment="Center" />
                                <TextBlock Text="Saved Moments" Margin="10,0,0,0" Foreground="#E2E8F0" FontSize="14" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,0,6">
                                <TextBlock Text="☰" Foreground="#94A3B8" FontSize="12" Width="28" TextAlignment="Center" />
                                <TextBlock Text="Notes" Margin="10,0,0,0" Foreground="#94A3B8" FontSize="14" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,0,6">
                                <TextBlock Text="⌑" Foreground="#94A3B8" FontSize="12" Width="28" TextAlignment="Center" />
                                <TextBlock Text="Bookmarks" Margin="10,0,0,0" Foreground="#94A3B8" FontSize="14" />
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="#233653" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="Sources"
                                       Foreground="#64748B"
                                       FontSize="12"
                                       Margin="2,0,0,4" />
                            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,0,6">
                                <TextBlock Text="▦" Foreground="#E2E8F0" FontSize="12" Width="28" TextAlignment="Center" />
                                <TextBlock Text="Apps" Margin="10,0,0,0" Foreground="#E2E8F0" FontSize="14" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,0,6">
                                <TextBlock Text="◎" Foreground="#94A3B8" FontSize="12" Width="28" TextAlignment="Center" />
                                <TextBlock Text="Websites" Margin="10,0,0,0" Foreground="#94A3B8" FontSize="14" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,0,6">
                                <TextBlock Text="□" Foreground="#94A3B8" FontSize="12" Width="28" TextAlignment="Center" />
                                <TextBlock Text="Files" Margin="10,0,0,0" Foreground="#94A3B8" FontSize="14" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="4"
                            Margin="0,0,0,14">
                    <Border Height="1" Background="#233653" Margin="0,0,0,16" />
                    <DockPanel Margin="0,0,0,14">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="34"
                                    Height="34"
                                    Background="#8B5CF6"
                                    CornerRadius="17">
                                <TextBlock Text="B"
                                           Foreground="White"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0">
                                <TextBlock Text="blakb"
                                           Foreground="#F8FAFC"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="GREENMONKEY\\blakb"
                                           Foreground="#94A3B8"
                                           FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <Button Classes="nav"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Foreground="#CBD5E1"
                            BorderBrush="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <TextBlock Text="⚙"
                                       Width="28"
                                       TextAlignment="Center"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Settings"
                                       Margin="10,0,0,0"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="0"
                HorizontalAlignment="Right"
                Width="1"
                Margin="0,8,10,8"
                Background="#233653" />

        <Grid Grid.Column="1" RowDefinitions="66,*"
              Margin="22,0,0,0">
            <Grid Margin="16,12,18,0"
                  PointerPressed="ToolbarDragRegion_PointerPressed">
                    <Grid ColumnDefinitions="*,142,96,50,50,50,50"
                          ColumnSpacing="12"
                          VerticalAlignment="Center">
                        <Border x:Name="SearchSurface"
                                Background="#111C31"
                                BorderBrush="#233653"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="14,8"
                                MinHeight="40">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock x:Name="SearchIconText"
                                           Text="⌕"
                                           Foreground="#64748B"
                                           FontSize="20"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="SearchTextBox"
                                         Classes="searchBox"
                                         Grid.Column="1"
                                         TextChanged="SearchTextBox_TextChanged"
                                         GotFocus="SearchTextBox_GotFocus"
                                         LostFocus="SearchTextBox_LostFocus"
                                         PlaceholderText="Search moments, sessions, apps, or websites..."
                                         PlaceholderForeground="#64748B"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#E2E8F0" />
                            </Grid>
                        </Border>
                        <ComboBox x:Name="DateFilterComboBox"
                                  Classes="filter"
                                  Grid.Column="1"
                                  SelectionChanged="DateFilterComboBox_SelectionChanged"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  MinHeight="40" />
                        <ComboBox x:Name="TypeFilterComboBox"
                                  Classes="filter"
                                  Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  MinHeight="40" />
                        <Button Grid.Column="3"
                                Classes="toolbar"
                                Click="ToggleDetailsButton_Click"
                                Width="48">
                            <TextBlock Text="☰"
                                       FontSize="14" />
                        </Button>
                        <Button Grid.Column="4"
                                Classes="toolbar"
                                Click="MinimizeShellButton_Click"
                                Width="48">
                            <TextBlock Text="−" FontSize="16" />
                        </Button>
                        <Button Grid.Column="5"
                                Classes="toolbar"
                                Click="MaximizeShellButton_Click"
                                Width="48">
                            <TextBlock Text="□" FontSize="13" />
                        </Button>
                        <Button Grid.Column="6"
                                Classes="toolbar"
                                Click="CloseShellButton_Click"
                                Width="48">
                            <TextBlock Text="×" FontSize="16" />
                        </Button>
                    </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid x:Name="TimelinePage" Margin="28,20,22,0">
                    <Grid x:Name="TimelineContentGrid"
                          ColumnDefinitions="*,380"
                          ClipToBounds="True">
                    <Grid Grid.Column="0"
                          Margin="0,0,18,0"
                          MinWidth="0"
                          ClipToBounds="True"
                          RowDefinitions="Auto,*">
                            <StackPanel Margin="8,0,0,20"
                                        Spacing="0">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10">
                                    <TextBlock Text="Timeline"
                                               Foreground="#F8FAFC"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                    <Border Classes="infoChip"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TimelineCountText"
                                                   Text="Moments"
                                                   Foreground="#CBD5E1"
                                                   FontSize="13"
                                                   Margin="0,2,0,0" />
                                    </Border>
                                    <Border Classes="infoChip"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Stored locally · Only visible to you"
                                                   Foreground="#94A3B8"
                                                   FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TimelineSubtitleText"
                                           Text="Grouped into local moments and arranged along a shared activity rail."
                                           Foreground="#64748B"
                                           FontSize="13"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          ClipToBounds="True">
                                <ItemsControl x:Name="TimelineGroupsItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="36,*" Margin="0,0,0,24">
                                                <Grid>
                                                    <Border Width="2"
                                                            Background="#223756"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,28,0,0" />
                                                    <Border Width="16"
                                                            Height="16"
                                                            CornerRadius="8"
                                                            Background="{Binding AccentBrush}"
                                                            BorderBrush="#D8D4FF"
                                                            BorderThickness="2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Top"
                                                            Margin="0,12,0,0" />
                                                </Grid>
                                                    <StackPanel Grid.Column="1" Spacing="16">
                                                    <Grid ColumnDefinitions="104,*" ColumnSpacing="12">
                                                        <Border Background="{Binding AccentBrush}"
                                                                CornerRadius="12"
                                                                Padding="9,3"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding TimeRange}"
                                                                       Foreground="White"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding Name}"
                                                                           Foreground="#F8FAFC"
                                                                           FontSize="15"
                                                                           FontWeight="SemiBold" />
                                                                <Border Background="#1C2540"
                                                                        BorderBrush="#253653"
                                                                        BorderThickness="1"
                                                                        CornerRadius="10"
                                                                        Padding="9,3"
                                                                        Margin="10,-1,0,0"
                                                                        VerticalAlignment="Top">
                                                                    <TextBlock Text="{Binding CountLabel}"
                                                                               Foreground="#A78BFA"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold" />
                                                                </Border>
                                                             </StackPanel>
                                                             <TextBlock Text="{Binding Summary}"
                                                                        Foreground="#94A3B8"
                                                                        Margin="0,7,0,0"
                                                                        FontSize="12"
                                                                        TextWrapping="Wrap" />
                                                         </StackPanel>
                                                     </Grid>
                                                    <ItemsControl ItemsSource="{Binding Moments}"
                                                                  Margin="0,2,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Click="TimelineMomentButton_Click"
                                                                        Classes="momentCard"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="0"
                                                                        Margin="0,0,12,12"
                                                                        HorizontalAlignment="Stretch">
                                                                        <Border Width="218"
                                                                                Height="150"
                                                                                Background="{Binding CardBackground}"
                                                                                BorderBrush="{Binding BorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="8"
                                                                                Padding="0">
                                                                            <Grid RowDefinitions="82,*">
                                                                                <Border Background="#10192B"
                                                                                        CornerRadius="8"
                                                                                        Padding="0"
                                                                                        ClipToBounds="True">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="Auto" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <Image Source="{Binding PreviewUri}"
                                                                                               Stretch="UniformToFill"
                                                                                               IsVisible="{Binding ShowPreview}" />
                                                                                        <Border Background="#10192B"
                                                                                                IsVisible="{Binding ShowGlyphFallback}" />
                                                                                        <Border Grid.Column="1"
                                                                                                Background="#21324E"
                                                                                                CornerRadius="5"
                                                                                                Padding="6,2"
                                                                                                Margin="0,8,8,0"
                                                                                                VerticalAlignment="Top">
                                                                                            <TextBlock Text="{Binding TimeLabel}"
                                                                                                       Foreground="#CBD5E1"
                                                                                                       FontSize="11" />
                                                                                        </Border>
                                                                                        <Border Width="60"
                                                                                                Height="60"
                                                                                                CornerRadius="16"
                                                                                                Background="{Binding GlyphBackground}"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                IsVisible="{Binding ShowGlyphFallback}">
                                                                                            <TextBlock Text="{Binding Glyph}"
                                                                                                       Foreground="{Binding GlyphForeground}"
                                                                                                       FontSize="20"
                                                                                                       FontWeight="Bold"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       VerticalAlignment="Center" />
                                                                                        </Border>
                                                                                        <Border HorizontalAlignment="Right"
                                                                                                VerticalAlignment="Bottom"
                                                                                                Margin="0,0,8,8"
                                                                                                Background="#16233A"
                                                                                                CornerRadius="5"
                                                                                                Padding="6,2">
                                                                                            <TextBlock Text="{Binding SeenLabel}"
                                                                                                       Foreground="#F8FAFC"
                                                                                                       FontSize="11"
                                                                                                       FontWeight="SemiBold" />
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </Border>
                                                                                <Grid Grid.Row="1"
                                                                                      Margin="10,8,10,8"
                                                                                      RowDefinitions="Auto,Auto">
                                                                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                                                                          ColumnSpacing="7">
                                                                                        <Border Width="18"
                                                                                                Height="18"
                                                                                                CornerRadius="0"
                                                                                                Background="Transparent"
                                                                                                VerticalAlignment="Top">
                                                                                            <TextBlock Text="{Binding Glyph}"
                                                                                                       Foreground="{Binding GlyphForeground}"
                                                                                                       FontSize="10"
                                                                                                       FontWeight="SemiBold"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       VerticalAlignment="Center" />
                                                                                        </Border>
                                                                                        <TextBlock Grid.Column="1"
                                                                                                   Text="{Binding Title}"
                                                                                                   Foreground="#F8FAFC"
                                                                                                   FontWeight="SemiBold"
                                                                                                   TextWrapping="Wrap"
                                                                                                   FontSize="13"
                                                                                                   MaxWidth="154"
                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Grid.Column="2"
                                                                                                   Text="⋮"
                                                                                                   Foreground="#94A3B8"
                                                                                                   FontSize="16"
                                                                                                   VerticalAlignment="Top" />
                                                                                    </Grid>
                                                                                    <TextBlock Grid.Row="1"
                                                                                               Text="{Binding Subtitle}"
                                                                                               Foreground="#94A3B8"
                                                                                               Margin="25,2,0,0"
                                                                                               FontSize="12"
                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                </Grid>
                                                                            </Grid>
                                                                        </Border>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                    <Border x:Name="DetailSurface"
                            Grid.Column="1"
                            Width="380"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource PanelEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="24,30,22,24">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Grid ColumnDefinitions="62,*" ColumnSpacing="0">
                                <Border x:Name="DetailGlyphHost"
                                        Width="62"
                                        Height="62"
                                        CornerRadius="9"
                                        Background="{DynamicResource SubtlePanelBrush}">
                                    <TextBlock x:Name="DetailGlyphText"
                                               Text="MT"
                                               Foreground="#A78BFA"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="14,5,0,0"
                                            Spacing="6">
                                    <TextBlock x:Name="DetailTitleText"
                                               Text="Select a moment"
                                               Foreground="#F8FAFC"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="DetailSubtitleText"
                                               Text="Timeline context appears here"
                                               Foreground="#94A3B8"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        Margin="0,24,0,18">
                                <Button x:Name="OpenMomentButton"
                                        Classes="detailPrimary"
                                        Click="OpenMomentButton_Click">
                                    <TextBlock Text="↗ Open"
                                               FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="PinMomentButton"
                                        Classes="detailSecondary"
                                        Click="PinMomentButton_Click">
                                    <TextBlock x:Name="PinMomentButtonText"
                                               Text="Pin"
                                               FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="BookmarkMomentButton"
                                        Classes="detailSecondary"
                                        Click="BookmarkMomentButton_Click">
                                    <TextBlock x:Name="BookmarkMomentButtonText"
                                               Text="Bookmark"
                                               FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="DeleteMomentButton"
                                        Classes="detailDanger"
                                        Click="DeleteMomentButton_Click"
                                        Width="42"
                                        Height="42"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center">
                                    <Grid Width="42" Height="42">
                                        <TextBlock Text=""
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,0,0,0">
                                <Grid RowDefinitions="35,1" Margin="0,0,0,16">
                                    <Grid ColumnDefinitions="*,*,*">
                                        <Button x:Name="OverviewDetailTabButton"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="DetailTabButton_Click"
                                                CommandParameter="Overview"
                                                Padding="0">
                                            <Grid RowDefinitions="*,3">
                                                <TextBlock x:Name="OverviewDetailTabText"
                                                           Text="Overview"
                                                           Foreground="#A78BFA"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Border x:Name="OverviewDetailTabUnderline"
                                                        Grid.Row="1"
                                                        Background="#8B5CF6"
                                                        CornerRadius="2"
                                                        Margin="12,0" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="ActivityDetailTabButton"
                                                Grid.Column="1"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="DetailTabButton_Click"
                                                CommandParameter="Activity"
                                                Padding="0">
                                            <Grid RowDefinitions="*,3">
                                                <TextBlock x:Name="ActivityDetailTabText"
                                                           Text="Activity"
                                                           Foreground="#94A3B8"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Border x:Name="ActivityDetailTabUnderline"
                                                        Grid.Row="1"
                                                        Background="#8B5CF6"
                                                        CornerRadius="2"
                                                        Margin="12,0"
                                                        IsVisible="False" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="RelatedDetailTabButton"
                                                Grid.Column="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="DetailTabButton_Click"
                                                CommandParameter="Related"
                                                Padding="0">
                                            <Grid RowDefinitions="*,3">
                                                <TextBlock x:Name="RelatedDetailTabText"
                                                           Text="Related"
                                                           Foreground="#94A3B8"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Border x:Name="RelatedDetailTabUnderline"
                                                        Grid.Row="1"
                                                        Background="#8B5CF6"
                                                        CornerRadius="2"
                                                        Margin="12,0"
                                                        IsVisible="False" />
                                            </Grid>
                                        </Button>
                                    </Grid>
                                    <Border Grid.Row="1"
                                            Background="#233653"
                                            Opacity="0.9" />
                                </Grid>

                                <ScrollViewer x:Name="OverviewDetailTabContent"
                                              Grid.Row="1"
                                              Margin="0,0,0,0"
                                              VerticalScrollBarVisibility="Visible"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Border Background="{DynamicResource SubtlePanelBrush}"
                                                BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="16"
                                                Margin="0,0,0,18">
                                            <StackPanel>
                                                <TextBlock Text="Moment overview"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,10" />
                                                <TextBlock x:Name="DetailNarrativeText"
                                                           Text="Select a moment to inspect its grouped raw activity and nearby related work."
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="13"
                                                           LineHeight="19"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                                <Border x:Name="DetailPreviewHost"
                                                        Background="{DynamicResource PanelBrush}"
                                                        BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        ClipToBounds="True"
                                                        Height="150"
                                                        Margin="0,0,0,18"
                                                        IsVisible="False">
                                                    <Image x:Name="DetailPreviewImage"
                                                           Stretch="UniformToFill" />
                                                </Border>
                                                <Border Background="{DynamicResource SubtlePanelBrush}"
                                                        BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="16"
                                                        Margin="0,0,0,18">
                                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                                          ColumnDefinitions="Auto,*"
                                                          RowSpacing="10"
                                                          ColumnSpacing="14">
                                                        <TextBlock Text="Visible span"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Margin="0,0,0,12" />
                                                        <TextBlock Grid.Column="1"
                                                                   x:Name="DetailMetaSpanText"
                                                                   Text="Local only"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   Margin="0,0,0,12" />
                                                        <TextBlock Grid.Row="1"
                                                                   Text="From"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Margin="0,0,0,12" />
                                                        <TextBlock Grid.Row="1"
                                                                   Grid.Column="1"
                                                                   x:Name="DetailMetaStartedText"
                                                                   Text="Local only"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   Margin="0,0,0,12"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="2"
                                                                   Text="Until"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Margin="0,0,0,12" />
                                                        <TextBlock Grid.Row="2"
                                                                   Grid.Column="1"
                                                                   x:Name="DetailMetaEndedText"
                                                                   Text="Local only"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   Margin="0,0,0,12"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="3"
                                                                   Text="Source"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Margin="0,0,0,12" />
                                                        <TextBlock Grid.Row="3"
                                                                   Grid.Column="1"
                                                                   x:Name="DetailMetaSourceText"
                                                                   Text="MomentTrace"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   Margin="0,0,0,12"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="4"
                                                                   Text="Category"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Margin="0,0,0,12" />
                                                        <Border Grid.Row="4"
                                                                Grid.Column="1"
                                                                Background="{DynamicResource AccentBrush}"
                                                                CornerRadius="4"
                                                                HorizontalAlignment="Left"
                                                                Padding="7,2"
                                                                Margin="0,0,0,12">
                                                            <TextBlock x:Name="DetailMetaCategoryText"
                                                                       Text="Moment"
                                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock Grid.Row="5"
                                                                   Text="Privacy"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Grid.Row="5"
                                                                   Grid.Column="1"
                                                                   Text="Stored locally"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                    </Grid>
                                                </Border>
                                                <Border Background="#10192B"
                                                        BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="16"
                                                        Margin="0,0,0,18">
                                                    <StackPanel>
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                                            <TextBlock Text="Personal note"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold" />
                                                            <Button Grid.Column="1"
                                                                    Classes="detailSecondary"
                                                                    Click="SaveNoteButton_Click"
                                                                    Padding="10,6">
                                                                <TextBlock Text="Save note"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold" />
                                                            </Button>
                                                        </Grid>
                                                        <TextBox x:Name="MomentNoteTextBox"
                                                                 Background="{DynamicResource PanelBrush}"
                                                                 BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                                 BorderThickness="1"
                                                                 Foreground="{DynamicResource TextBrush}"
                                                                 MinHeight="78"
                                                                 Padding="12"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{DynamicResource SubtlePanelBrush}"
                                                        BorderBrush="{DynamicResource PanelEdgeBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="16">
                                                    <StackPanel>
                                                        <TextBlock Text="Recent Activity"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="14"
                                                                   Margin="0,0,0,12"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="Recorded by MomentTrace"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="13"
                                                                   Margin="0,0,0,10" />
                                                        <TextBlock Text="Recording foreground window activity with timestamps."
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="13"
                                                                   LineHeight="19"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer x:Name="ActivityDetailTabContent"
                                              Grid.Row="1"
                                              Margin="0,14,0,0"
                                              IsVisible="False"
                                              VerticalScrollBarVisibility="Visible"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <Border Background="#111C31"
                                                BorderBrush="#233653"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12"
                                                Margin="0,0,0,0">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Captured activity"
                                                           Foreground="#CBD5E1"
                                                           FontWeight="SemiBold" />
                                                <TextBlock x:Name="ActivityTabSummaryText"
                                                           Text="Select a moment to inspect its raw captured entries."
                                                           Foreground="#64748B"
                                                           TextWrapping="Wrap" />
                                                <ItemsControl x:Name="RawEntriesItems">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#16233A"
                                                                    BorderBrush="#253653"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Padding="10"
                                                                    Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Source}" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding TimeRange}" Foreground="#64748B" Margin="0,6,0,0" FontSize="11" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                </ScrollViewer>

                                <ScrollViewer x:Name="RelatedDetailTabContent"
                                              Grid.Row="1"
                                              Margin="0,14,0,0"
                                              IsVisible="False"
                                              VerticalScrollBarVisibility="Visible"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <Border Background="#111C31"
                                                BorderBrush="#233653"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12"
                                                Margin="0,0,0,0">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Related moments"
                                                           Foreground="#CBD5E1"
                                                           FontWeight="SemiBold" />
                                                <TextBlock x:Name="RelatedSummaryText"
                                                           Text="No related moments yet"
                                                           Foreground="#64748B"
                                                           TextWrapping="Wrap" />
                                                <ItemsControl x:Name="RelatedMomentsItems">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#16233A"
                                                                    BorderBrush="#253653"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Padding="10"
                                                                    Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Detail}" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                </Grid>

            <ScrollViewer x:Name="OverviewPage" Grid.Row="1" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="18">
                    <Border Background="#0F1A2E"
                            BorderBrush="#233653"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Overview"
                                           Foreground="#F8FAFC"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <Border Classes="infoChip"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Local analytics"
                                               Foreground="#94A3B8"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="OverviewSubtitleText"
                                       Text="A local read on how the day is taking shape"
                                       Foreground="#94A3B8"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Classes="overviewMetric">
                            <StackPanel Spacing="8">
                                <Border Height="3" Background="#7C5CFF" CornerRadius="2" HorizontalAlignment="Stretch" />
                                <TextBlock Text="Remembered span" Foreground="#94A3B8" />
                                <TextBlock x:Name="MetricOneValue" Text="0m" Foreground="#F8FAFC" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock x:Name="MetricOneDetail" Text="" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="overviewMetric">
                            <StackPanel Spacing="8">
                                <Border Height="3" Background="#22C55E" CornerRadius="2" HorizontalAlignment="Stretch" />
                                <TextBlock Text="Moments" Foreground="#94A3B8" />
                                <TextBlock x:Name="MetricTwoValue" Text="0" Foreground="#F8FAFC" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock x:Name="MetricTwoDetail" Text="" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="overviewMetric">
                            <StackPanel Spacing="8">
                                <Border Height="3" Background="#0EA5E9" CornerRadius="2" HorizontalAlignment="Stretch" />
                                <TextBlock Text="Most seen app" Foreground="#94A3B8" />
                                <TextBlock x:Name="MetricThreeValue" Text="Waiting" Foreground="#F8FAFC" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock x:Name="MetricThreeDetail" Text="" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Classes="overviewMetric">
                            <StackPanel Spacing="8">
                                <Border Height="3" Background="#F59E0B" CornerRadius="2" HorizontalAlignment="Stretch" />
                                <TextBlock Text="Longest visible run" Foreground="#94A3B8" />
                                <TextBlock x:Name="MetricFourValue" Text="0m" Foreground="#F8FAFC" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock x:Name="MetricFourDetail" Text="" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Classes="overviewPanel">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Daily activity heatmap" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" />
                                <Border Grid.Column="1" Classes="infoChip">
                                    <TextBlock Text="15 minute blocks" Foreground="#94A3B8" FontSize="11" />
                                </Border>
                            </Grid>
                            <TextBlock Text="A lightweight read on how the day filled in over time."
                                       Foreground="#64748B"
                                       FontSize="11" />
                            <WrapPanel x:Name="HeatmapPanel" ItemWidth="10" ItemHeight="28" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="1.2*,0.8*" ColumnSpacing="18">
                        <Border Grid.Column="0" Classes="overviewPanel">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Text="Top applications" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Sorted from the local activity store"
                                                   Foreground="#64748B"
                                                   FontSize="11"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button x:Name="TopAppsSeenSortButton" Grid.Column="1" Classes="toolbar" Click="TopAppsSortButton_Click" CommandParameter="Duration" Padding="10,6">
                                        <TextBlock Text="Seen" FontSize="11" />
                                    </Button>
                                    <Button x:Name="TopAppsSessionsSortButton" Grid.Column="2" Classes="toolbar" Click="TopAppsSortButton_Click" CommandParameter="Sessions" Padding="10,6">
                                        <TextBlock Text="Sessions" FontSize="11" />
                                    </Button>
                                    <Button x:Name="TopAppsPercentSortButton" Grid.Column="3" Classes="toolbar" Click="TopAppsSortButton_Click" CommandParameter="Percent" Padding="10,6">
                                        <TextBlock Text="Percent" FontSize="11" />
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,0">
                                    <TextBlock Text="Application"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="Seen"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,52,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="%"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <ItemsControl x:Name="TopAppsItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#16233A" BorderBrush="#253653" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                                    <Border Width="34"
                                                            Height="34"
                                                            Background="{Binding AccentBrush}"
                                                            CornerRadius="10"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Glyph}"
                                                                   Foreground="White"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding AppName}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Meta}" Foreground="#94A3B8" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <Border Grid.Column="3"
                                                            Background="#111C31"
                                                            BorderBrush="#253653"
                                                            BorderThickness="1"
                                                            CornerRadius="999"
                                                            Padding="8,2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Percent}" Foreground="#94A3B8" FontSize="11" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="18">
                            <Border Classes="overviewPanel">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Focus rhythm" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Longer visible runs grouped from local activity."
                                               Foreground="#64748B"
                                               FontSize="11" />
                                    <ItemsControl x:Name="FocusBlocksItems">
                                        <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#16233A" BorderBrush="#253653" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <Border Height="3"
                                                                Background="{Binding AccentBrush}"
                                                                CornerRadius="2"
                                                                Margin="0,0,0,8" />
                                                        <TextBlock Text="{Binding Label}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Duration}" Foreground="#94A3B8" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Classes="overviewPanel">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Legend" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Colour hints used across heatmap and grouped moments."
                                               Foreground="#64748B"
                                               FontSize="11" />
                                    <ItemsControl x:Name="LegendItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                                                    <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Fill}" />
                                                    <TextBlock Text="{Binding Label}" Foreground="#CBD5E1" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
