<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MomentTrace.Desktop.MainWindow"
        Title="MomentTrace"
        Width="1360"
        Height="840"
        MinWidth="1120"
        MinHeight="720"
        Background="#08111F">
    <Window.Styles>
        <Style Selector="Button.momentCard:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.97" />
        </Style>
        <Style Selector="Button.toolbar">
            <Setter Property="Background" Value="#172743" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#2B3D5B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="ComboBox.filter">
            <Setter Property="Background" Value="#111C31" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#233653" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TabControl.detailTabs TabItem">
            <Setter Property="Foreground" Value="#94A3B8" />
        </Style>
        <Style Selector="TabControl.detailTabs TabItem:selected">
            <Setter Property="Foreground" Value="#F8FAFC" />
        </Style>
    </Window.Styles>
    <Grid ColumnDefinitions="240,*" Margin="18">
        <Border Grid.Column="0"
                Background="#0F1A2E"
                BorderBrush="#233653"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18"
                Margin="0,0,18,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#172743">
                            <TextBlock Text="MT"
                                       Foreground="#A78BFA"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="MomentTrace"
                                       Foreground="#F8FAFC"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusText"
                                       Text="Loading local timeline..."
                                       Foreground="#94A3B8"
                                       FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,28,0,0" Spacing="8">
                    <Button x:Name="TimelineNavButton"
                            Click="TimelineNavButton_Click"
                            HorizontalContentAlignment="Left"
                            Background="#7C5CFF"
                            Foreground="White"
                            BorderBrush="#7C5CFF"
                            BorderThickness="1"
                            Padding="14,10">
                        <TextBlock Text="Timeline" FontWeight="SemiBold" />
                    </Button>
                    <Button x:Name="OverviewNavButton"
                            Click="OverviewNavButton_Click"
                            HorizontalContentAlignment="Left"
                            Background="#172743"
                            Foreground="#CBD5E1"
                            BorderBrush="#2B3D5B"
                            BorderThickness="1"
                            Padding="14,10">
                        <TextBlock Text="Overview" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>

                <Border Grid.Row="2"
                        Margin="0,24,0,0"
                        Background="#111C31"
                        BorderBrush="#233653"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Workspace"
                                   Foreground="#F8FAFC"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="ShellSummaryText"
                                   Text="Connecting to local storage"
                                   Foreground="#CBD5E1"
                                   TextWrapping="Wrap" />
                        <Border Height="1" Background="#233653" Margin="0,8,0,8" />
                        <TextBlock Text="This cross-platform shell is reading the same local database and presentation layer as the Windows app."
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="3"
                           Text="Cross-platform reader spike"
                           Foreground="#64748B"
                           FontSize="12"
                           Margin="2,14,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid x:Name="TimelinePage" RowDefinitions="Auto,*">
                <Border Background="#0F1A2E"
                        BorderBrush="#233653"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">
                    <Grid ColumnDefinitions="*,220,Auto" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Border Background="#111C31"
                                BorderBrush="#233653"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,10">
                            <TextBox x:Name="SearchTextBox"
                                     TextChanged="SearchTextBox_TextChanged"
                                     PlaceholderText="Search moments, sessions, apps, or websites..."
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#E2E8F0" />
                        </Border>
                        <ComboBox x:Name="DateFilterComboBox"
                                  Classes="filter"
                                  Grid.Column="1"
                                  SelectionChanged="DateFilterComboBox_SelectionChanged"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0"
                                  MinHeight="42" />
                        <Button Grid.Column="2"
                                Classes="toolbar"
                                Click="RefreshButton_Click"
                                Margin="12,0,0,0">
                            <TextBlock Text="Refresh" />
                        </Button>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Timeline"
                                           Foreground="#F8FAFC"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                                <Border Background="#1B2640"
                                        BorderBrush="#253653"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Stored locally"
                                               Foreground="#C4B5FD"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TimelineSubtitleText"
                                       Text="Reading local moments"
                                       Foreground="#94A3B8"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="1.3*,0.9*" Margin="0,18,0,0">
                    <Border Background="#0F1A2E"
                            BorderBrush="#233653"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16"
                            Margin="0,0,18,0">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock x:Name="TimelineCountText"
                                       Text="Moments"
                                       Foreground="#CBD5E1"
                                       Margin="0,0,0,14" />
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl x:Name="TimelineGroupsItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="36,*" Margin="0,0,0,22">
                                                <Grid>
                                                    <Border Width="2"
                                                            Background="#223756"
                                                            HorizontalAlignment="Center"
                                                            Margin="0,28,0,0" />
                                                    <Border Width="16"
                                                            Height="16"
                                                            CornerRadius="8"
                                                            Background="{Binding AccentBrush}"
                                                            BorderBrush="#D8D4FF"
                                                            BorderThickness="2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Top"
                                                            Margin="0,12,0,0" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Spacing="12">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                        <Border Background="{Binding AccentBrush}"
                                                                CornerRadius="999"
                                                                Padding="10,4"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding TimeRange}"
                                                                       Foreground="White"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="#F8FAFC"
                                                                           FontSize="17"
                                                                           FontWeight="SemiBold" />
                                                                <Border Background="#1C2540"
                                                                        BorderBrush="#253653"
                                                                        BorderThickness="1"
                                                                        CornerRadius="999"
                                                                        Padding="8,2"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding CountLabel}"
                                                                               Foreground="#A78BFA"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Summary}"
                                                                       Foreground="#94A3B8"
                                                                       Margin="0,5,0,0"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                                  VerticalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding Moments}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Click="TimelineMomentButton_Click"
                                                                            Classes="momentCard"
                                                                            CommandParameter="{Binding}"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Padding="0"
                                                                            HorizontalAlignment="Stretch">
                                                                        <Border Width="232"
                                                                                MinHeight="170"
                                                                                Background="{Binding CardBackground}"
                                                                                BorderBrush="{Binding BorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="14"
                                                                                Padding="14">
                                                                            <Grid RowDefinitions="Auto,*,Auto">
                                                                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                                                                                    <Border Background="{Binding KindBackground}"
                                                                                            CornerRadius="999"
                                                                                            Padding="8,2"
                                                                                            VerticalAlignment="Top">
                                                                                        <TextBlock Text="{Binding KindLabel}"
                                                                                                   Foreground="{Binding KindForeground}"
                                                                                                   FontSize="11"
                                                                                                   FontWeight="SemiBold" />
                                                                                    </Border>
                                                                                    <StackPanel Grid.Column="1"
                                                                                                Orientation="Horizontal"
                                                                                                HorizontalAlignment="Right"
                                                                                                Spacing="6">
                                                                                        <Border Background="#21324E"
                                                                                                CornerRadius="999"
                                                                                                Padding="8,2">
                                                                                            <TextBlock Text="{Binding TimeLabel}"
                                                                                                       Foreground="#CBD5E1"
                                                                                                       FontSize="11" />
                                                                                        </Border>
                                                                                        <Border Background="#201A38"
                                                                                                IsVisible="{Binding IsSelected}"
                                                                                                CornerRadius="999"
                                                                                                Padding="8,2">
                                                                                            <TextBlock Text="Selected"
                                                                                                       Foreground="#C4B5FD"
                                                                                                       FontSize="11"
                                                                                                       FontWeight="SemiBold" />
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                                <Border Width="54"
                                                                                        Height="54"
                                                                                        CornerRadius="14"
                                                                                        Background="{Binding GlyphBackground}">
                                                                                    <TextBlock Text="{Binding Glyph}"
                                                                                               Foreground="{Binding GlyphForeground}"
                                                                                               FontWeight="Bold"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center" />
                                                                                </Border>
                                                                                <StackPanel Grid.Row="1"
                                                                                            Margin="0,14,0,0">
                                                                                    <TextBlock Text="{Binding Title}"
                                                                                               Foreground="#F8FAFC"
                                                                                               FontWeight="SemiBold"
                                                                                               TextWrapping="Wrap"
                                                                                               MaxHeight="48" />
                                                                                    <TextBlock Text="{Binding Subtitle}"
                                                                                               Foreground="#94A3B8"
                                                                                               Margin="0,8,0,0"
                                                                                               TextWrapping="Wrap"
                                                                                               MaxHeight="42" />
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Row="2"
                                                                                            Margin="0,12,0,0"
                                                                                            Spacing="6">
                                                                                    <TextBlock Text="{Binding Meta}"
                                                                                               Foreground="#64748B"
                                                                                               FontSize="11"
                                                                                               TextWrapping="Wrap" />
                                                                                    <StackPanel Orientation="Horizontal"
                                                                                                Spacing="6">
                                                                                        <Border Background="#172743"
                                                                                                BorderBrush="#253653"
                                                                                                BorderThickness="1"
                                                                                                CornerRadius="999"
                                                                                                Padding="8,2">
                                                                                            <TextBlock Text="{Binding SeenLabel}"
                                                                                                       Foreground="#CBD5E1"
                                                                                                       FontSize="11" />
                                                                                        </Border>
                                                                                        <Border Background="#1F2A20"
                                                                                                IsVisible="{Binding HasSavedIndicator}"
                                                                                                BorderBrush="#2F4A31"
                                                                                                BorderThickness="1"
                                                                                                CornerRadius="999"
                                                                                                Padding="8,2">
                                                                                            <TextBlock Text="{Binding SavedIndicator}"
                                                                                                       Foreground="#9FE3A6"
                                                                                                       FontSize="11" />
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Background="#0F1A2E"
                            BorderBrush="#233653"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">
                            <TextBlock x:Name="DetailTitleText"
                                       Text="Select a moment"
                                       Foreground="#F8FAFC"
                                       FontSize="19"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="DetailSubtitleText"
                                       Grid.Row="1"
                                       Text="Timeline context appears here"
                                       Foreground="#94A3B8"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <Border Grid.Row="2"
                                    Background="#152238"
                                    BorderBrush="#233653"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,18,0,0">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Moment context"
                                               Foreground="#CBD5E1"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="DetailNarrativeText"
                                               Text="Select a moment to inspect its grouped raw activity and nearby related work."
                                               Foreground="#94A3B8"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="3" Margin="0,18,0,0">
                                <TabControl Background="Transparent"
                                            Classes="detailTabs"
                                            BorderThickness="0">
                                    <TabItem Header="Overview">
                                        <Border Background="#111C31"
                                                BorderBrush="#233653"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12"
                                                Margin="0,12,0,0">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Moment overview"
                                                           Foreground="#CBD5E1"
                                                           FontWeight="SemiBold" />
                                                <TextBlock x:Name="RawSummaryText"
                                                           Text="No moment selected"
                                                           Foreground="#94A3B8"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="Stored locally and assembled from grouped activity in the shared presentation layer."
                                                           Foreground="#64748B"
                                                           TextWrapping="Wrap"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="Activity">
                                        <Border Background="#111C31"
                                                BorderBrush="#233653"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12"
                                                Margin="0,12,0,0">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Captured activity"
                                                           Foreground="#CBD5E1"
                                                           FontWeight="SemiBold" />
                                                <ItemsControl x:Name="RawEntriesItems">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#16233A"
                                                                    BorderBrush="#253653"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Padding="10"
                                                                    Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Source}" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding TimeRange}" Foreground="#64748B" Margin="0,6,0,0" FontSize="11" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="Related">
                                        <Border Background="#111C31"
                                                BorderBrush="#233653"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12"
                                                Margin="0,12,0,0">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Related moments"
                                                           Foreground="#CBD5E1"
                                                           FontWeight="SemiBold" />
                                                <TextBlock x:Name="RelatedSummaryText"
                                                           Text="No related moments yet"
                                                           Foreground="#64748B"
                                                           TextWrapping="Wrap" />
                                                <ItemsControl x:Name="RelatedMomentsItems">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#16233A"
                                                                    BorderBrush="#253653"
                                                                    BorderThickness="1"
                                                                    CornerRadius="10"
                                                                    Padding="10"
                                                                    Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Detail}" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="OverviewPage" IsVisible="False">
                <StackPanel Spacing="18">
                    <Border Background="#0F1A2E"
                            BorderBrush="#233653"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="Overview"
                                       Foreground="#F8FAFC"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="OverviewSubtitleText"
                                       Text="A local read on how the day is taking shape"
                                       Foreground="#94A3B8"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Background="#0F1A2E" BorderBrush="#233653" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Remembered span" Foreground="#94A3B8" />
                                <TextBlock x:Name="MetricOneValue" Text="0m" Foreground="#F8FAFC" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock x:Name="MetricOneDetail" Text="" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#0F1A2E" BorderBrush="#233653" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Moments" Foreground="#94A3B8" />
                                <TextBlock x:Name="MetricTwoValue" Text="0" Foreground="#F8FAFC" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock x:Name="MetricTwoDetail" Text="" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#0F1A2E" BorderBrush="#233653" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Most seen app" Foreground="#94A3B8" />
                                <TextBlock x:Name="MetricThreeValue" Text="Waiting" Foreground="#F8FAFC" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock x:Name="MetricThreeDetail" Text="" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#0F1A2E" BorderBrush="#233653" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Longest visible run" Foreground="#94A3B8" />
                                <TextBlock x:Name="MetricFourValue" Text="0m" Foreground="#F8FAFC" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock x:Name="MetricFourDetail" Text="" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="#0F1A2E" BorderBrush="#233653" BorderThickness="1" CornerRadius="14" Padding="16">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Daily activity heatmap" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" />
                                <Border Grid.Column="1" Background="#16233A" BorderBrush="#253653" BorderThickness="1" CornerRadius="999" Padding="10,4">
                                    <TextBlock Text="15 minute blocks" Foreground="#94A3B8" FontSize="11" />
                                </Border>
                            </Grid>
                            <WrapPanel x:Name="HeatmapPanel" ItemWidth="10" ItemHeight="28" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="1.2*,0.8*" ColumnSpacing="18">
                        <Border Grid.Column="0" Background="#0F1A2E" BorderBrush="#233653" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Text="Top applications" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Sorted from the local activity store"
                                                   Foreground="#64748B"
                                                   FontSize="11"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button x:Name="TopAppsSeenSortButton" Grid.Column="1" Click="TopAppsSortButton_Click" CommandParameter="Duration" Background="#172743" Foreground="#CBD5E1" BorderBrush="#2B3D5B" BorderThickness="1" Padding="10,6">
                                        <TextBlock Text="Seen" FontSize="11" />
                                    </Button>
                                    <Button x:Name="TopAppsSessionsSortButton" Grid.Column="2" Click="TopAppsSortButton_Click" CommandParameter="Sessions" Background="#172743" Foreground="#CBD5E1" BorderBrush="#2B3D5B" BorderThickness="1" Padding="10,6">
                                        <TextBlock Text="Sessions" FontSize="11" />
                                    </Button>
                                    <Button x:Name="TopAppsPercentSortButton" Grid.Column="3" Click="TopAppsSortButton_Click" CommandParameter="Percent" Background="#172743" Foreground="#CBD5E1" BorderBrush="#2B3D5B" BorderThickness="1" Padding="10,6">
                                        <TextBlock Text="Percent" FontSize="11" />
                                    </Button>
                                </Grid>
                                <ItemsControl x:Name="TopAppsItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#16233A" BorderBrush="#253653" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding AppName}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Meta}" Foreground="#94A3B8" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Duration}" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Percent}" Foreground="#64748B" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="18">
                            <Border Background="#0F1A2E" BorderBrush="#233653" BorderThickness="1" CornerRadius="14" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Focus rhythm" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" />
                                    <ItemsControl x:Name="FocusBlocksItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#16233A" BorderBrush="#253653" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" Foreground="#F8FAFC" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Duration}" Foreground="#94A3B8" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="#0F1A2E" BorderBrush="#233653" BorderThickness="1" CornerRadius="14" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Legend" Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" />
                                    <ItemsControl x:Name="LegendItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                                                    <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Fill}" />
                                                    <TextBlock Text="{Binding Label}" Foreground="#CBD5E1" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
