<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MomentTrace.Desktop.SettingsWindow"
        Title="Settings"
	        Width="720"
	        Height="660"
	        MinWidth="640"
	        MinHeight="560"
	        CanResize="True"
	        TransparencyLevelHint="Blur, Transparent"
	        WindowDecorations="BorderOnly"
	        ExtendClientAreaToDecorationsHint="True"
	        ExtendClientAreaTitleBarHeightHint="0"
	        Background="Transparent">
  <Window.Styles>
    <Style Selector="Button.titleButton">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.titleButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.settings">
      <Setter Property="Background" Value="{DynamicResource SubtlePanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button.settings:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ComboBox.settingsCombo">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="TextBox.settingsText">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="CheckBox.privacyItem">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="CheckBox.privacyItem:pointerover /template/ Border#PrivacyRoot">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ScrollBar">
      <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ScrollBar:vertical">
      <Setter Property="Width" Value="10" />
      <Setter Property="MinWidth" Value="10" />
      <Setter Property="Margin" Value="8,0,4,0" />
    </Style>
    <Style Selector="ScrollBar:horizontal">
      <Setter Property="Height" Value="10" />
      <Setter Property="MinHeight" Value="10" />
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton">
      <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>
    <Style Selector="ScrollBar /template/ Button">
      <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="MinWidth" Value="8" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ScrollBar:pointerover /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pressed">
      <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
    </Style>
    <Style Selector="Thumb.ScrollBarThumb">
      <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Thumb.ScrollBarThumb:pointerover">
      <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Thumb.ScrollBarThumb:pressed">
      <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
      <Setter Property="Fill" Value="{DynamicResource ScrollTrackBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="RepeatButton.ScrollBarPageButton">
      <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
    </Style>
  </Window.Styles>

  <Border Background="{DynamicResource PanelBrush}"
          BorderBrush="{DynamicResource PanelEdgeBrush}"
          BorderThickness="1"
          CornerRadius="8">
    <Grid RowDefinitions="42,*,Auto">
      <Grid Background="{DynamicResource SubtlePanelBrush}"
            PointerPressed="TitleBar_PointerPressed">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Margin="14,0,0,0"
                      Spacing="8">
            <Border Width="20"
                    Height="20"
                    Background="{DynamicResource ToolbarBrush}"
                    CornerRadius="5">
              <TextBlock Text="MT"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock Text="Settings"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0">
            <Button Classes="titleButton"
                    Content="-"
                    Click="TitleMinimizeButton_Click" />
            <Button x:Name="TitleMaximizeButton"
                    Classes="titleButton"
                    Content="□"
                    Click="TitleMaximizeButton_Click" />
            <Button Classes="titleButton"
                    Content="×"
                    Click="CloseButton_Click" />
          </StackPanel>
        </Grid>
      </Grid>

      <Grid Grid.Row="1" Margin="26,26,26,0">
        <Grid RowDefinitions="Auto,*">
      <StackPanel>
        <TextBlock Text="Settings"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" />
        <TextBlock Text="Control startup, recording, appearance, privacy, and local storage paths."
                   Margin="0,6,0,0"
                   FontSize="13"
                   Foreground="{DynamicResource MutedTextBrush}" />
      </StackPanel>

      <ScrollViewer x:Name="SettingsScrollViewer"
                    Grid.Row="1"
                    Margin="0,24,0,20"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20"
                    Margin="0,0,18,0">
          <StackPanel Spacing="12">
            <TextBlock Text="Recording"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <CheckBox x:Name="StartWithWindowsCheckBox"
                      Content="Start with Windows"
                      Foreground="{DynamicResource TextBrush}" />
            <Button x:Name="RecordingButton"
                    Classes="settings"
                    Content="Recorder unavailable in this shell"
                    IsEnabled="False"
                    Width="220"
                    HorizontalAlignment="Left" />
          </StackPanel>

          <Border Height="1" Background="{DynamicResource PanelEdgeBrush}" />

          <StackPanel Spacing="12">
            <TextBlock Text="Appearance"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <Grid ColumnDefinitions="*,220" ColumnSpacing="16">
              <StackPanel>
                <TextBlock Text="Theme" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Text="Choose the app colour palette. Transparency still applies."
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}" />
              </StackPanel>
              <ComboBox x:Name="ThemeComboBox"
                        Classes="settingsCombo"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch" />
            </Grid>

            <Grid ColumnDefinitions="*,220" ColumnSpacing="16">
              <StackPanel>
                <TextBlock Text="Timeline view" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Text="Choose compact rows or Windows Timeline-style cards."
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}" />
              </StackPanel>
              <ComboBox x:Name="TimelineViewModeComboBox"
                        Classes="settingsCombo"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Cards" />
                <ComboBoxItem Content="List" />
              </ComboBox>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Transparency" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Text="Adjusts how clear the shell is while keeping the same colour."
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}" />
              </StackPanel>
              <TextBlock x:Name="OpacityValueText"
                         Grid.Column="1"
                         Foreground="{DynamicResource TextBrush}"
                         VerticalAlignment="Center" />
            </Grid>
            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" />
          </StackPanel>

          <Border Height="1" Background="{DynamicResource PanelEdgeBrush}" />

          <StackPanel Spacing="12">
            <TextBlock Text="Privacy filters"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <CheckBox x:Name="ExcludeAdultWebsitesCheckBox"
                      Content="Exclude adult websites from history"
                      Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="Matching sites are skipped before they are saved or screenshotted. Checks are local."
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel>
                <TextBlock Text="Adult domain blocklist" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="AdultBlocklistStatusText"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}" />
              </StackPanel>
              <Button x:Name="UpdateAdultBlocklistButton"
                      Classes="settings"
                      Grid.Column="1"
                      Content="Update list"
                      Width="126" />
            </Grid>

            <Grid ColumnDefinitions="*,14,*" ColumnSpacing="0">
              <StackPanel>
                <TextBlock Text="Always exclude domains" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBox x:Name="CustomBlockedDomainsTextBox"
                         Classes="settingsText"
                         Height="84"
                         Margin="0,8,0,0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Always allow domains" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBox x:Name="CustomAllowedDomainsTextBox"
                         Classes="settingsText"
                         Height="84"
                         Margin="0,8,0,0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Choose from recent activity"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="Tick anything you do not want MomentTrace to save from now on."
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}" />

            <Grid ColumnDefinitions="*,14,*">
              <Border Background="{DynamicResource SubtlePanelBrush}"
                      BorderBrush="{DynamicResource PanelEdgeBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="12">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Apps"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="RecentAppsStatusText"
                               Grid.Column="1"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11" />
                  </Grid>
                  <ItemsControl x:Name="RecentAppsList" Margin="0,10,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2"
                      Background="{DynamicResource SubtlePanelBrush}"
                      BorderBrush="{DynamicResource PanelEdgeBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="12">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Websites"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="RecentWebsitesStatusText"
                               Grid.Column="1"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11" />
                  </Grid>
                  <ItemsControl x:Name="RecentWebsitesList" Margin="0,10,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <Button x:Name="SavePrivacyFiltersButton"
                    Classes="settings"
                    Content="Save privacy filters"
                    Width="168"
                    HorizontalAlignment="Left" />
          </StackPanel>

          <Border Height="1" Background="{DynamicResource PanelEdgeBrush}" />

          <StackPanel Spacing="12">
            <TextBlock Text="Local activity data"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Text="Export or clear the timeline stored on this device. These actions do not use cloud services."
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="ExportActivityButton"
                      Classes="settings"
                      Content="Export activity"
                      Width="136" />
              <Button x:Name="DeleteActivityButton"
                      Classes="settings"
                      Content="Delete local activity"
                      Width="166" />
            </StackPanel>
            <TextBlock x:Name="LocalActivityStatusText"
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}" />
          </StackPanel>

          <Border Height="1" Background="{DynamicResource PanelEdgeBrush}" />

          <StackPanel Spacing="12">
            <TextBlock Text="Where I Live"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
              <TextBlock Text="Version" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock x:Name="VersionText" Grid.Column="1" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="Installed at" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock x:Name="InstallPathText" Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Text="App data" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock x:Name="AppDataPathText" Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Text="Database" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock x:Name="DatabasePathText" Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Text="Settings file" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock x:Name="SettingsPathText" Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
        </Grid>
      </Grid>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="26,0,26,26">
        <Button x:Name="CloseButton"
                Classes="settings"
                Content="Close"
                Width="96" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
